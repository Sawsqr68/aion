//! Repeated child call sites inside one sequential collection fork.
workflow repeated_child_calls
  input values: [String]
  outcome done: type Done, route success

type Row  { value: String }
type Done { rows: [Row] }

child run_one(value: String) -> Row

step run_all
  fork value in values sequential
    run_one(value: value)
    run_one(value: value)
  join -> rows

step report
  route done(rows: rows)
