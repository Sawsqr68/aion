//!   case `variadic_parameter_passed_to_dependency_is_joined_with_spaces`.
//! JUST-SPECIMEN: foo *args: (bar args)
//! WHY REFUSED: assembling a command from parts at run time produces a command
//!   no reader saw, which is the review property a gate leg exists to have.

workflow just_multi_step_assembly
  outcome done: type String, route success

command foo(args: [String])
  program "echo"
  admits "--"
  then "bar"

step go
  route done("ok")
