//! The list says WHICH variables cross into the harness child; each value
//! comes from the launching context. Writing a value into a document puts a
//! secret in a file that gets committed, diffed and deployed.
workflow ask_the_agent
  input question: String
  outcome answered: type Answer, route success

type Answer { reply: String }

/// The canonical agent-outcome record: the checker demands the STRUCTURE, not
/// a blessed name.
type Reply { text: String, stop_reason: String, session_id: String }

worker assistants
  harness
    kind acp
    concurrency 4
    reconnect_initial_backoff 5s
    reconnect_max_backoff 2m
    reconnect_max_attempts 100
    env_pass "PATH", "ANTHROPIC_API_KEY=sk-live-1"
    command "/usr/local/bin/claude-code-acp"
    cwd "/srv/agents/workspace"
    permission "deny"
    exit_grace 10s
  action ask(prompt: String) -> Reply
    agent

step ask
  ask(prompt: question) -> reply
  route answered(reply: reply.text)
