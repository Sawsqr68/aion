//! A record of the wrong fields is not the agent-outcome contract. The
//! harness emits exactly `text`, `final_message`, `stop_reason`, and
//! `session_id`; this `Answer` shape would defer a guaranteed decode failure to run time.
workflow ask_the_agent
  input question: String
  outcome answered: type Answer, route success

type Answer { reply: String }

worker assistants
  action ask(prompt: String) -> Answer
    agent

step ask
  ask(prompt: question) -> answer
  route answered(reply: answer.reply)
