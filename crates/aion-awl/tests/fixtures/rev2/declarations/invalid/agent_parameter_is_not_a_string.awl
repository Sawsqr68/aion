//! An agent's one parameter is the prompt handed to the harness. A structured
//! input has no place to go on the wire to an agent.
workflow brief_the_agent
  input brief: Brief
  outcome answered: type Answer, route success

type Answer { reply: String }
type Brief  { question: String }
type Reply  { text: String, stop_reason: String, session_id: String }

worker assistants
  action ask(brief: Brief) -> Reply
    agent

step ask
  ask(brief: brief) -> reply
  route answered(reply: reply.text)
