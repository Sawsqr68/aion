//! The pre-#241 record is not the agent-outcome contract any more. The harness emits exactly
//! `text`, `final_message`, `stop_reason`, AND `session_id`; a declaration missing
//! `final_message` is stale, and the wire will never deliver it — REPLACE semantics, no
//! compatibility window. The checker diagnostic must name the missing mandatory field.
workflow ask_the_agent
  input question: String
  outcome answered: type String, route success

type Reply { text: String, stop_reason: String, session_id: String }

worker assistants
  action ask(prompt: String) -> Reply
    agent

step ask
  ask(prompt: question) -> reply
  route answered(reply.text)
