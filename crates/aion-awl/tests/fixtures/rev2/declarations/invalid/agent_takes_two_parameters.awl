//! `agent` names a SHAPE: one `String` prompt in, the agent-outcome record
//! out. Two parameters leave the harness choosing which one to send, and a
//! marker whose meaning depends on an adapter's choice is not a contract.
workflow brief_the_agent
  input question: String
  outcome answered: type Answer, route success

type Answer { reply: String }
type Reply  { text: String, stop_reason: String }

worker assistants
  action ask(prompt: String, context: String) -> Reply
    agent

step ask
  ask(prompt: question, context: question) -> reply
  route answered(reply: reply.text)
