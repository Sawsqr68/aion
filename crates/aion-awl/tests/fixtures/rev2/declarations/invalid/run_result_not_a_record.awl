//! A bodied action always hands back the outcome OBJECT; a scalar result
//! type could never be that object.
workflow notify_once
  input message: String
  outcome sent: type Receipt, route success

type Receipt { stdout: String }

worker notifier
  action send_message(message: String) -> String
    run "notify --body $message"

step send
  send_message(message: message) -> receipt
  route sent(stdout: message)
