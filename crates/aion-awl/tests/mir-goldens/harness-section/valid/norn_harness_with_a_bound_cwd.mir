module review_a_tree source=review_a_tree.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_review:
    aion@activity:task_queue/2 [activities] (v2, lit#13)
    aion@workflow:run/1 [activities] (v3)
== durable families == activities
== atoms ==
  [0] answer
  [1] reply
  [2] review_input
  [3] review_a_tree_input
  [4] answered_outcome
  [5] ok
== literals ==
  [0] "reply"
  [1] "text"
  [2] "stop_reason"
  [3] "repo"
  [4] "prompt"
  [5] "tree"
  [6] "question"
  [7] "answered"
  [8] "outcome"
  [9] ""
  [10] "ReviewATreeOutcome"
  [11] "answered"
  [12] "payload"
  [13] "reviewers"
== types ==
  record Answer tag=answer
    reply: string
  record Reply tag=reply
    text: string
    stop_reason: string
  record ReviewInput tag=review_input
    repo: string
    prompt: string
  record ReviewATreeInput tag=review_a_tree_input
    tree: string
    question: string
  union ReviewATreeOutcome
    answered -> answered_outcome(ref(Answer))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=review_a_tree_input_codec output=review_a_tree_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(review_a_tree.ReviewATreeInput, review_a_tree.ReviewATreeOutcome, AwlError)
  T-DEF name="review_a_tree" input=review_a_tree_input_codec output=review_a_tree_outcome_codec
== fn execute/1 origin=execute ==
  sig: (review_a_tree.ReviewATreeInput) -> Result(review_a_tree.ReviewATreeOutcome, AwlError)
  T-EXEC fields=[tree:String, question:String] entry=step_review args=[1, 0]
== fn answer_codec/0 origin=codec_template(RecordTrio, Answer, record#0) ==
  sig: () -> Codec(review_a_tree.Answer)
  v0 = make_closure answer_to_json captures=[]
  v1 = call_local answer_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn answer_to_json/1 origin=codec_template(RecordTrio, Answer, record#0) ==
  sig: (review_a_tree.Answer) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"reply": v1|>awlc.string_to_json}
  return v2
== fn answer_decoder/0 origin=codec_template(RecordTrio, Answer, record#0) ==
  sig: () -> Decoder(review_a_tree.Answer)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure answer_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn answer_decoder$0/1 origin=lifted(answer_decoder, #0) ==
  sig: (String) -> Decoder(review_a_tree.Answer)
  v1 = record(answer, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn reply_codec/0 origin=codec_template(RecordTrio, Reply, record#1) ==
  sig: () -> Codec(review_a_tree.Reply)
  v0 = make_closure reply_to_json captures=[]
  v1 = call_local reply_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn reply_to_json/1 origin=codec_template(RecordTrio, Reply, record#1) ==
  sig: (review_a_tree.Reply) -> Json
  v1 = field(v0, 1)
  v2 = field(v0, 2)
  v3 = json_obj {"text": v1|>awlc.string_to_json, "stop_reason": v2|>awlc.string_to_json}
  return v3
== fn reply_decoder/0 origin=codec_template(RecordTrio, Reply, record#1) ==
  sig: () -> Decoder(review_a_tree.Reply)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure reply_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#1, v0, v1)
== fn reply_decoder$0/1 origin=lifted(reply_decoder, #0) ==
  sig: (String) -> Decoder(review_a_tree.Reply)
  v1 = call_rt aion@awl@codec:string_decoder/0() live_after=[v0]
  v2 = make_closure reply_decoder$1 captures=[v0]
  tail_rt gleam@dynamic@decode:field/3(lit#2, v1, v2)
== fn reply_decoder$1/2 origin=lifted(reply_decoder, #1) ==
  sig: (String, String) -> Decoder(review_a_tree.Reply)
  v2 = record(reply, [v1, v0])
  tail_rt gleam@dynamic@decode:success/1(v2)
== fn review_input_codec/0 origin=codec_template(RecordTrio, ReviewInput, record#2) ==
  sig: () -> Codec(review_a_tree.ReviewInput)
  v0 = make_closure review_input_to_json captures=[]
  v1 = call_local review_input_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn review_input_to_json/1 origin=codec_template(RecordTrio, ReviewInput, record#2) ==
  sig: (review_a_tree.ReviewInput) -> Json
  v1 = field(v0, 1)
  v2 = field(v0, 2)
  v3 = json_obj {"repo": v1|>awlc.string_to_json, "prompt": v2|>awlc.string_to_json}
  return v3
== fn review_input_decoder/0 origin=codec_template(RecordTrio, ReviewInput, record#2) ==
  sig: () -> Decoder(review_a_tree.ReviewInput)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure review_input_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#3, v0, v1)
== fn review_input_decoder$0/1 origin=lifted(review_input_decoder, #0) ==
  sig: (String) -> Decoder(review_a_tree.ReviewInput)
  v1 = call_rt aion@awl@codec:string_decoder/0() live_after=[v0]
  v2 = make_closure review_input_decoder$1 captures=[v0]
  tail_rt gleam@dynamic@decode:field/3(lit#4, v1, v2)
== fn review_input_decoder$1/2 origin=lifted(review_input_decoder, #1) ==
  sig: (String, String) -> Decoder(review_a_tree.ReviewInput)
  v2 = record(review_input, [v1, v0])
  tail_rt gleam@dynamic@decode:success/1(v2)
== fn review_a_tree_input_codec/0 origin=codec_template(RecordTrio, ReviewATreeInput, record#3) ==
  sig: () -> Codec(review_a_tree.ReviewATreeInput)
  v0 = make_closure review_a_tree_input_to_json captures=[]
  v1 = call_local review_a_tree_input_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn review_a_tree_input_to_json/1 origin=codec_template(RecordTrio, ReviewATreeInput, record#3) ==
  sig: (review_a_tree.ReviewATreeInput) -> Json
  v1 = field(v0, 1)
  v2 = field(v0, 2)
  v3 = json_obj {"tree": v1|>awlc.string_to_json, "question": v2|>awlc.string_to_json}
  return v3
