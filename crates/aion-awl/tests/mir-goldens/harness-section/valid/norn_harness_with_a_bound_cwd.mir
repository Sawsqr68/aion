  sig: () -> Decoder(review_a_tree.ReviewATreeInput)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure review_a_tree_input_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#5, v0, v1)
== fn review_a_tree_input_decoder$0/1 origin=lifted(review_a_tree_input_decoder, #0) ==
  sig: (String) -> Decoder(review_a_tree.ReviewATreeInput)
  v1 = call_rt aion@awl@codec:string_decoder/0() live_after=[v0]
  v2 = make_closure review_a_tree_input_decoder$1 captures=[v0]
  tail_rt gleam@dynamic@decode:field/3(lit#6, v1, v2)
== fn review_a_tree_input_decoder$1/2 origin=lifted(review_a_tree_input_decoder, #1) ==
  sig: (String, String) -> Decoder(review_a_tree.ReviewATreeInput)
  v2 = record(review_a_tree_input, [v1, v0])
  tail_rt gleam@dynamic@decode:success/1(v2)
== fn review_a_tree_outcome_codec/0 origin=codec_template(UnionTrio, ReviewATreeOutcome, union#4) ==
  sig: () -> Codec(review_a_tree.ReviewATreeOutcome)
  v0 = make_closure review_a_tree_outcome_to_json captures=[]
  v1 = call_local review_a_tree_outcome_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn review_a_tree_outcome_to_json/1 origin=codec_template(UnionTrio, ReviewATreeOutcome, union#4) ==
  sig: (review_a_tree.ReviewATreeOutcome) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"outcome": lit#7|>awlc.string_to_json, "payload": v1|>answer_to_json}
  return v2
== fn review_a_tree_outcome_decoder/0 origin=codec_template(UnionTrio, ReviewATreeOutcome, union#4) ==
  sig: () -> Decoder(review_a_tree.ReviewATreeOutcome)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure review_a_tree_outcome_decoder$outcome captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#8, v0, v1)
== fn review_a_tree_outcome_decoder$outcome/1 origin=lifted(review_a_tree_outcome_decoder, #0) ==
  sig: (String) -> Decoder(review_a_tree.ReviewATreeOutcome)
  if cmp Eq v0 lit#11:
    v3 = call_local answer_decoder()
    v4 = make_closure review_a_tree_outcome_decoder$arm0 captures=[]
    tail_rt gleam@dynamic@decode:field/3(lit#12, v3, v4)
  else:
    v1 = record(answer, [lit#9])
    v2 = record(answered_outcome, [v1])
    tail_rt gleam@dynamic@decode:failure/2(v2, lit#10)
== fn review_a_tree_outcome_decoder$arm0/1 origin=lifted(review_a_tree_outcome_decoder, #1) ==
  sig: (review_a_tree.Answer) -> Decoder(review_a_tree.ReviewATreeOutcome)
  v1 = record(answered_outcome, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn review_activity/2 origin=activity_wrapper(review, raw=false) ==
  sig: (String, String) -> Activity(review_a_tree.ReviewInput, review_a_tree.Reply)
  T-ACT action=review input_codec=review_input_codec return=reply_codec
== fn step_review/2 origin=region(review) ==
  sig: (String, String) -> Result(review_a_tree.ReviewATreeOutcome, AwlError)
  v2 = call_local review_activity(v1, v0)
  v3 = call_rt aion@activity:task_queue/2(v2, lit#13)
  v4 = call_rt aion@workflow:run/1(v3)
  v5 = call_rt aion@awl@error:map_activity_error/1(v4)
  v6 = try_bind v5
  v7 = field(v6, 1)
  v8 = record(answer, [v7])
  v9 = record(answered_outcome, [v8])
  v10 = record(ok, [v9])
  return v10
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
  T-DEAD
