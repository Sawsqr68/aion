module acp_harness_launch source=acp_harness_launch.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_ask:
    aion@activity:task_queue/2 [activities] (v1, lit#12)
    aion@workflow:run/1 [activities] (v2)
== durable families == activities
== atoms ==
  [0] answer
  [1] reply
  [2] ask_input
  [3] acp_harness_launch_input
  [4] answered_outcome
  [5] ok
== literals ==
  [0] "reply"
  [1] "text"
  [2] "stop_reason"
  [3] "session_id"
  [4] "prompt"
  [5] "question"
  [6] "answered"
  [7] "outcome"
  [8] ""
  [9] "AcpHarnessLaunchOutcome"
  [10] "answered"
  [11] "payload"
  [12] "assistants"
== types ==
  record Answer tag=answer
    reply: string
  record Reply tag=reply
    text: string
    stop_reason: string
    session_id: string
  record AskInput tag=ask_input
    prompt: string
  record AcpHarnessLaunchInput tag=acp_harness_launch_input
    question: string
  union AcpHarnessLaunchOutcome
    answered -> answered_outcome(ref(Answer))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=acp_harness_launch_input_codec output=acp_harness_launch_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(acp_harness_launch.AcpHarnessLaunchInput, acp_harness_launch.AcpHarnessLaunchOutcome, AwlError)
  T-DEF name="acp_harness_launch" input=acp_harness_launch_input_codec output=acp_harness_launch_outcome_codec
== fn execute/1 origin=execute ==
  sig: (acp_harness_launch.AcpHarnessLaunchInput) -> Result(acp_harness_launch.AcpHarnessLaunchOutcome, AwlError)
  T-EXEC fields=[question:String] entry=step_ask args=[0]
== fn answer_codec/0 origin=codec_template(RecordTrio, Answer, record#0) ==
  sig: () -> Codec(acp_harness_launch.Answer)
  v0 = make_closure answer_to_json captures=[]
  v1 = call_local answer_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn answer_to_json/1 origin=codec_template(RecordTrio, Answer, record#0) ==
  sig: (acp_harness_launch.Answer) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"reply": v1|>awlc.string_to_json}
  return v2
== fn answer_decoder/0 origin=codec_template(RecordTrio, Answer, record#0) ==
  sig: () -> Decoder(acp_harness_launch.Answer)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure answer_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn answer_decoder$0/1 origin=lifted(answer_decoder, #0) ==
  sig: (String) -> Decoder(acp_harness_launch.Answer)
  v1 = record(answer, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn reply_codec/0 origin=codec_template(RecordTrio, Reply, record#1) ==
  sig: () -> Codec(acp_harness_launch.Reply)
  v0 = make_closure reply_to_json captures=[]
  v1 = call_local reply_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn reply_to_json/1 origin=codec_template(RecordTrio, Reply, record#1) ==
  sig: (acp_harness_launch.Reply) -> Json
  v1 = field(v0, 1)
  v2 = field(v0, 2)
  v3 = field(v0, 3)
  v4 = json_obj {"text": v1|>awlc.string_to_json, "stop_reason": v2|>awlc.string_to_json, "session_id": v3|>awlc.string_to_json}
  return v4
== fn reply_decoder/0 origin=codec_template(RecordTrio, Reply, record#1) ==
  sig: () -> Decoder(acp_harness_launch.Reply)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure reply_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#1, v0, v1)
== fn reply_decoder$0/1 origin=lifted(reply_decoder, #0) ==
  sig: (String) -> Decoder(acp_harness_launch.Reply)
  v1 = call_rt aion@awl@codec:string_decoder/0() live_after=[v0]
  v2 = make_closure reply_decoder$1 captures=[v0]
  tail_rt gleam@dynamic@decode:field/3(lit#2, v1, v2)
== fn reply_decoder$1/2 origin=lifted(reply_decoder, #1) ==
  sig: (String, String) -> Decoder(acp_harness_launch.Reply)
  v2 = call_rt aion@awl@codec:string_decoder/0() live_after=[v0, v1]
  v3 = make_closure reply_decoder$2 captures=[v1, v0]
  tail_rt gleam@dynamic@decode:field/3(lit#3, v2, v3)
== fn reply_decoder$2/3 origin=lifted(reply_decoder, #2) ==
  sig: (String, String, String) -> Decoder(acp_harness_launch.Reply)
  v3 = record(reply, [v1, v2, v0])
  tail_rt gleam@dynamic@decode:success/1(v3)
== fn ask_input_codec/0 origin=codec_template(RecordTrio, AskInput, record#2) ==
  sig: () -> Codec(acp_harness_launch.AskInput)
  v0 = make_closure ask_input_to_json captures=[]
  v1 = call_local ask_input_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn ask_input_to_json/1 origin=codec_template(RecordTrio, AskInput, record#2) ==
  sig: (acp_harness_launch.AskInput) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"prompt": v1|>awlc.string_to_json}
  return v2
== fn ask_input_decoder/0 origin=codec_template(RecordTrio, AskInput, record#2) ==
  sig: () -> Decoder(acp_harness_launch.AskInput)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure ask_input_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#4, v0, v1)
== fn ask_input_decoder$0/1 origin=lifted(ask_input_decoder, #0) ==
  sig: (String) -> Decoder(acp_harness_launch.AskInput)
  v1 = record(ask_input, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn acp_harness_launch_input_codec/0 origin=codec_template(RecordTrio, AcpHarnessLaunchInput, record#3) ==
  sig: () -> Codec(acp_harness_launch.AcpHarnessLaunchInput)
  v0 = make_closure acp_harness_launch_input_to_json captures=[]
  v1 = call_local acp_harness_launch_input_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn acp_harness_launch_input_to_json/1 origin=codec_template(RecordTrio, AcpHarnessLaunchInput, record#3) ==
  sig: (acp_harness_launch.AcpHarnessLaunchInput) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"question": v1|>awlc.string_to_json}
  return v2
== fn acp_harness_launch_input_decoder/0 origin=codec_template(RecordTrio, AcpHarnessLaunchInput, record#3) ==
  sig: () -> Decoder(acp_harness_launch.AcpHarnessLaunchInput)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure acp_harness_launch_input_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#5, v0, v1)
== fn acp_harness_launch_input_decoder$0/1 origin=lifted(acp_harness_launch_input_decoder, #0) ==
  sig: (String) -> Decoder(acp_harness_launch.AcpHarnessLaunchInput)
  v1 = record(acp_harness_launch_input, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn acp_harness_launch_outcome_codec/0 origin=codec_template(UnionTrio, AcpHarnessLaunchOutcome, union#4) ==
  sig: () -> Codec(acp_harness_launch.AcpHarnessLaunchOutcome)
  v0 = make_closure acp_harness_launch_outcome_to_json captures=[]
  v1 = call_local acp_harness_launch_outcome_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn acp_harness_launch_outcome_to_json/1 origin=codec_template(UnionTrio, AcpHarnessLaunchOutcome, union#4) ==
  sig: (acp_harness_launch.AcpHarnessLaunchOutcome) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"outcome": lit#6|>awlc.string_to_json, "payload": v1|>answer_to_json}
  return v2
== fn acp_harness_launch_outcome_decoder/0 origin=codec_template(UnionTrio, AcpHarnessLaunchOutcome, union#4) ==
  sig: () -> Decoder(acp_harness_launch.AcpHarnessLaunchOutcome)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure acp_harness_launch_outcome_decoder$outcome captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#7, v0, v1)
== fn acp_harness_launch_outcome_decoder$outcome/1 origin=lifted(acp_harness_launch_outcome_decoder, #0) ==
  sig: (String) -> Decoder(acp_harness_launch.AcpHarnessLaunchOutcome)
  if cmp Eq v0 lit#10:
    v3 = call_local answer_decoder()
    v4 = make_closure acp_harness_launch_outcome_decoder$arm0 captures=[]
    tail_rt gleam@dynamic@decode:field/3(lit#11, v3, v4)
  else:
    v1 = record(answer, [lit#8])
    v2 = record(answered_outcome, [v1])
    tail_rt gleam@dynamic@decode:failure/2(v2, lit#9)
== fn acp_harness_launch_outcome_decoder$arm0/1 origin=lifted(acp_harness_launch_outcome_decoder, #1) ==
  sig: (acp_harness_launch.Answer) -> Decoder(acp_harness_launch.AcpHarnessLaunchOutcome)
  v1 = record(answered_outcome, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn ask_activity/1 origin=activity_wrapper(ask, raw=false) ==
  sig: (String) -> Activity(acp_harness_launch.AskInput, acp_harness_launch.Reply)
  T-ACT action=ask input_codec=ask_input_codec return=reply_codec
== fn step_ask/1 origin=region(ask) ==
  sig: (String) -> Result(acp_harness_launch.AcpHarnessLaunchOutcome, AwlError)
  v1 = call_local ask_activity(v0)
  v2 = call_rt aion@activity:task_queue/2(v1, lit#12)
  v3 = call_rt aion@workflow:run/1(v2)
  v4 = call_rt aion@awl@error:map_activity_error/1(v3)
  v5 = try_bind v4
  v6 = field(v5, 1)
  v7 = record(answer, [v6])
  v8 = record(answered_outcome, [v7])
  v9 = record(ok, [v8])
  return v9
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
  T-DEAD
