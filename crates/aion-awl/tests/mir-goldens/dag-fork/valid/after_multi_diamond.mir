== fn step_gather/1 origin=region(gather) ==
  sig: (String) -> Result(diamond_report.DiamondReportOutcome, AwlError)
  v1 = call_local gather_activity(v0)
  v2 = call_rt aion@activity:task_queue/2(v1, lit#19)
  v3 = call_rt aion@workflow:run/1(v2)
  v4 = call_rt aion@awl@error:map_activity_error/1(v3)
  v5 = try_bind v4
  tail_local step_claims(v5)
== fn step_claims/1 origin=chain_step(gather.claims) ==
  sig: (diamond_report.Sources) -> Result(diamond_report.DiamondReportOutcome, AwlError)
  v1 = field(v0, 1)
  v2 = call_local extract_claims_activity_raw(v1) live_after=[v0]
  v3 = call_rt aion@activity:task_queue/2(v2, lit#20) live_after=[v0]
  v4 = field(v0, 1)
  v5 = call_local collect_citations_activity_raw(v4) live_after=[v3]
  v6 = call_rt aion@activity:task_queue/2(v5, lit#21) live_after=[v3]
  v7 = list([v3, v6])
  v8 = call_rt aion@workflow:all/1(v7)
  v9 = call_rt aion@awl@error:map_activity_error/1(v8)
  v10 = try_bind v9
  assert_list [v11, v12] = v10
  v13 = call_local claims_codec() live_after=[v11, v12]
  v14 = call_rt aion@awl@codec:decoded/3(v13, v11, lit#22) live_after=[v12]
  v15 = try_bind v14 live_after=[v12]
  v16 = call_local citations_codec() live_after=[v12, v15]
  v17 = call_rt aion@awl@codec:decoded/3(v16, v12, lit#23) live_after=[v15]
  v18 = try_bind v17 live_after=[v15]
  tail_local step_compose(v18, v15)
== fn step_compose/2 origin=chain_step(gather.compose) ==
  sig: (diamond_report.Citations, diamond_report.Claims) -> Result(diamond_report.DiamondReportOutcome, AwlError)
  v2 = field(v1, 1)
  v3 = field(v0, 1)
  v4 = call_local compose_activity(v2, v3)
  v5 = call_rt aion@activity:task_queue/2(v4, lit#24)
  v6 = call_rt aion@workflow:run/1(v5)
  v7 = call_rt aion@awl@error:map_activity_error/1(v6)
  v8 = try_bind v7
  v9 = field(v8, 2)
  if is_true v9:
    v10 = field(v8, 1)
    v11 = record(reported, [v10])
    v12 = record(reported_outcome, [v11])
    v13 = record(ok, [v12])
    return v13
  else:
    v14 = field(v8, 1)
    v15 = record(incomplete, [v14])
    v16 = call_local incomplete_to_json(v15)
    v17 = call_rt gleam@json:to_string/1(v16)
    v18 = record(awl_outcome_failure, [lit#25, v17])
    v19 = record(error, [v18])
    return v19
