module diamond_report source=diamond_report.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_gather:
    aion@activity:task_queue/2 [activities] (v1, lit#19)
    aion@workflow:run/1 [activities] (v2)
  step_claims:
    aion@activity:task_queue/2 [activities] (v2, lit#20)
    aion@activity:task_queue/2 [activities] (v5, lit#21)
    aion@workflow:all/1 [activities] (v7)
  step_compose:
    aion@activity:task_queue/2 [activities] (v4, lit#24)
    aion@workflow:run/1 [activities] (v5)
== durable families == activities
== atoms ==
  [0] sources
  [1] claims
  [2] citations
  [3] report
  [4] reported
  [5] incomplete
  [6] collect_citations_input
  [7] compose_input
  [8] extract_claims_input
  [9] gather_input
  [10] diamond_report_input
  [11] reported_outcome
  [12] ok
  [13] awl_outcome_failure
  [14] error
== literals ==
  [0] "urls"
  [1] "facts"
  [2] "links"
  [3] "text"
  [4] "complete"
  [5] "text"
  [6] "text"
  [7] "urls"
  [8] "facts"
  [9] "links"
  [10] "urls"
  [11] "topic"
  [12] "topic"
  [13] "reported"
  [14] "outcome"
  [15] ""
  [16] "DiamondReportOutcome"
  [17] "reported"
  [18] "payload"
  [19] "research"
  [20] "research"
  [21] "research"
  [22] "extract_claims"
  [23] "collect_citations"
  [24] "research"
  [25] "incomplete"
== types ==
  record Sources tag=sources
    urls: list(string)
  record Claims tag=claims
    facts: list(string)
  record Citations tag=citations
    links: list(string)
  record Report tag=report
    text: string
    complete: bool
  record Reported tag=reported
    text: string
  record Incomplete tag=incomplete
    text: string
  record CollectCitationsInput tag=collect_citations_input
    urls: list(string)
  record ComposeInput tag=compose_input
    facts: list(string)
    links: list(string)
  record ExtractClaimsInput tag=extract_claims_input
    urls: list(string)
  record GatherInput tag=gather_input
    topic: string
  record DiamondReportInput tag=diamond_report_input
    topic: string
  union DiamondReportOutcome
    reported -> reported_outcome(ref(Reported))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=diamond_report_input_codec output=diamond_report_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(diamond_report.DiamondReportInput, diamond_report.DiamondReportOutcome, AwlError)
  T-DEF name="diamond_report" input=diamond_report_input_codec output=diamond_report_outcome_codec
== fn execute/1 origin=execute ==
  sig: (diamond_report.DiamondReportInput) -> Result(diamond_report.DiamondReportOutcome, AwlError)
  T-EXEC fields=[topic:String] entry=step_gather args=[0]
