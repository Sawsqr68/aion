== types ==
  record Target tag=target
    name: string
    platform: string
  record Prepared tag=prepared
    tag: string
  record Artifact tag=artifact
    name: string
    checksum: string
  record Notes tag=notes
    text: string
  record CheckResult tag=check_result
    name: string
    blocking: bool
  record Receipt tag=receipt
    name: string
    ok: bool
  record Released tag=released
    tag: string
    count: int
    notes: string
  record RejectedRelease tag=rejected_release
    tag: string
    failures: list(ref(CheckResult))
  record StalledRelease tag=stalled_release
    tag: string
    published: int
  record BuildTargetInput tag=build_target_input
    target: ref(Target)
    tag: string
  record CheckArtifactInput tag=check_artifact_input
    artifact: ref(Artifact)
  record PrepareInput tag=prepare_input
    version: string
  record PublishTargetInput tag=publish_target_input
    target: ref(Target)
    tag: string
  record RenderNotesInput tag=render_notes_input
    tag: string
  record ReleasePipelineCombinedInput tag=release_pipeline_combined_input
    version: string
    targets: list(ref(Target))
  union ReleasePipelineCombinedOutcome
    released -> released_outcome(ref(Released))
