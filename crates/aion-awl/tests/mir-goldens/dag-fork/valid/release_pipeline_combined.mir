  sig: () -> WorkflowDefinition(release_pipeline_combined.ReleasePipelineCombinedInput, release_pipeline_combined.ReleasePipelineCombinedOutcome, AwlError)
  T-DEF name="release_pipeline_combined" input=release_pipeline_combined_input_codec output=release_pipeline_combined_outcome_codec
== fn execute/1 origin=execute ==
  sig: (release_pipeline_combined.ReleasePipelineCombinedInput) -> Result(release_pipeline_combined.ReleasePipelineCombinedOutcome, AwlError)
  T-EXEC fields=[version:String, targets:List(release_pipeline_combined.Target)] entry=step_prepare args=[1, 0]
