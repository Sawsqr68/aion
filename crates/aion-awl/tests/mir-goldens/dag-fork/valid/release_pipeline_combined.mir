module release_pipeline_combined source=release_pipeline_combined.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_prepare:
    aion@activity:timeout/2 [activities] (v2, v3)
    aion@activity:task_queue/2 [activities] (v4, lit#33)
    aion@activity:node/2 [activities] (v5, lit#34)
    aion@workflow:run/1 [activities] (v6)
  step_build_all:
    aion@workflow:map/2 [activities] (v1, v2)
  step_notes:
    aion@activity:timeout/2 [activities] (v4, v5)
    aion@activity:task_queue/2 [activities] (v6, lit#37)
    aion@activity:node/2 [activities] (v7, lit#38)
    aion@workflow:run/1 [activities] (v8)
  step_verify:
    aion@workflow:map/2 [activities] (v0, v4)
  build_all_fork_0:
    aion@activity:retry/2 [activities] (v3, v6)
    aion@activity:timeout/2 [activities] (v7, v8)
    aion@activity:task_queue/2 [activities] (v9, lit#35)
    aion@activity:node/2 [activities] (v10, lit#36)
  verify_fork_1:
    aion@activity:timeout/2 [activities] (v1, v2)
    aion@activity:task_queue/2 [activities] (v3, lit#39)
    aion@activity:node/2 [activities] (v4, lit#40)
  publish_all_fork_2:
    aion@activity:timeout/2 [activities] (v4, v5)
    aion@activity:task_queue/2 [activities] (v6, lit#42)
    aion@activity:node/2 [activities] (v7, lit#43)
    aion@workflow:run/1 [activities] (v8)
