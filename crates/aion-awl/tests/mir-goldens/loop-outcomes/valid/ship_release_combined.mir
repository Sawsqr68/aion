== types ==
  record Build tag=build
    artifact: string
    green: bool
    log: string
  record Confirmation tag=confirmation
    operator: string
  record PublishReceipt tag=publish_receipt
    url: string
    verified: bool
  record Cleanup tag=cleanup
    removed: bool
  record Shipped tag=shipped
    artifact: string
    build_rounds: int
  record NotReady tag=not_ready
    reason: string
    rounds_spent: int
  record Failed tag=failed
    reason: string
  record BuildRoundInput tag=build_round_input
    target: string
    prior: ref(Build)
  record DeployCanaryInput tag=deploy_canary_input
    artifact: string
  record PublishReleaseInput tag=publish_release_input
    artifact: string
  record RemoveCanaryInput tag=remove_canary_input
    artifact: string
  record SnapshotLogsInput tag=snapshot_logs_input
    artifact: string
  record ShipReleaseInput tag=ship_release_input
    target: string
    max_build_rounds: int
  union ShipReleaseOutcome
    shipped -> shipped_outcome(ref(Shipped))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=ship_release_input_codec output=ship_release_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(ship_release.ShipReleaseInput, ship_release.ShipReleaseOutcome, AwlError)
  T-DEF name="ship_release" input=ship_release_input_codec output=ship_release_outcome_codec
== fn execute/1 origin=execute ==
  sig: (ship_release.ShipReleaseInput) -> Result(ship_release.ShipReleaseOutcome, AwlError)
  T-EXEC fields=[target:String, max_build_rounds:Int] entry=step_build args=[zero, 1, 0]
