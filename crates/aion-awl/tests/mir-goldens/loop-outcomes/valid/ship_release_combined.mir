module ship_release source=ship_release.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_canary:
    aion@activity:retry/2 [activities] (v9, v12)
    aion@activity:timeout/2 [activities] (v13, v14)
    aion@activity:task_queue/2 [activities] (v15, lit#33)
    aion@activity:node/2 [activities] (v16, lit#34)
    aion@workflow:run/1 [activities] (v17)
    aion@workflow:with_timeout/2 [timers] (v21, v22)
  step_publish:
    aion@activity:timeout/2 [activities] (v3, v4)
    aion@activity:task_queue/2 [activities] (v5, lit#35)
    aion@activity:node/2 [activities] (v6, lit#36)
    aion@workflow:run/1 [activities] (v7)
  step_cleanup:
    aion@activity:timeout/2 [activities] (v2, v3)
    aion@activity:task_queue/2 [activities] (v4, lit#41)
    aion@activity:node/2 [activities] (v5, lit#42)
    aion@workflow:run/1 [activities] (v6)
  build_loop_0:
    aion@activity:timeout/2 [activities] (v4, v5)
    aion@activity:task_queue/2 [activities] (v6, lit#28)
    aion@activity:node/2 [activities] (v7, lit#29)
    aion@workflow:run/1 [activities] (v8)
  canary_wait_0_receive:
    aion@workflow:receive/1 [signals] (v0)
  publish_on_failure:
    aion@activity:timeout/2 [activities] (v24, v25)
    aion@activity:task_queue/2 [activities] (v26, lit#39)
    aion@activity:node/2 [activities] (v27, lit#40)
    aion@workflow:run/1 [activities] (v28)
== durable families == timers, activities, signals
