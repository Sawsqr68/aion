  v1 = call_local prepare_dataset_outcome_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn prepare_dataset_outcome_to_json/1 origin=codec_template(UnionTrio, PrepareDatasetOutcome, union#6) ==
  sig: (prepare_dataset.PrepareDatasetOutcome) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"outcome": lit#8|>awlc.string_to_json, "payload": v1|>prepared_to_json}
  return v2
== fn prepare_dataset_outcome_decoder/0 origin=codec_template(UnionTrio, PrepareDatasetOutcome, union#6) ==
  sig: () -> Decoder(prepare_dataset.PrepareDatasetOutcome)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure prepare_dataset_outcome_decoder$outcome captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#9, v0, v1)
== fn prepare_dataset_outcome_decoder$outcome/1 origin=lifted(prepare_dataset_outcome_decoder, #0) ==
  sig: (String) -> Decoder(prepare_dataset.PrepareDatasetOutcome)
  if cmp Eq v0 lit#12:
    v3 = call_local prepared_decoder()
    v4 = make_closure prepare_dataset_outcome_decoder$arm0 captures=[]
    tail_rt gleam@dynamic@decode:field/3(lit#13, v3, v4)
  else:
    v1 = record(prepared, [lit#10, 0])
    v2 = record(prepared_outcome, [v1])
    tail_rt gleam@dynamic@decode:failure/2(v2, lit#11)
== fn prepare_dataset_outcome_decoder$arm0/1 origin=lifted(prepare_dataset_outcome_decoder, #1) ==
  sig: (prepare_dataset.Prepared) -> Decoder(prepare_dataset.PrepareDatasetOutcome)
  v1 = record(prepared_outcome, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn clean_activity/1 origin=activity_wrapper(clean, raw=false) ==
  sig: (String) -> Activity(prepare_dataset.CleanInput, prepare_dataset.Batch)
  T-ACT action=clean input_codec=clean_input_codec return=batch_codec
== fn fetch_activity/1 origin=activity_wrapper(fetch, raw=false) ==
  sig: (String) -> Activity(prepare_dataset.FetchInput, prepare_dataset.Batch)
  T-ACT action=fetch input_codec=fetch_input_codec return=batch_codec
== fn step_prepare/1 origin=region(prepare) ==
  sig: (String) -> Result(prepare_dataset.PrepareDatasetOutcome, AwlError)
  tail_local sub_prepare_fetch_batch(v0)
== fn sub_prepare_fetch_batch/1 origin=substep(prepare.fetch_batch) ==
  sig: (String) -> Result(prepare_dataset.PrepareDatasetOutcome, AwlError)
  v1 = call_local fetch_activity(v0)
  v2 = call_rt aion@duration:milliseconds/1(600000) live_after=[v1]
  v3 = call_rt aion@activity:timeout/2(v1, v2)
  v4 = call_rt aion@activity:task_queue/2(v3, lit#14)
  v5 = call_rt aion@activity:node/2(v4, lit#15)
  v6 = call_rt aion@workflow:run/1(v5)
  v7 = call_rt aion@awl@error:map_activity_error/1(v6)
  v8 = try_bind v7
  v10 = field(v8, 1)
  v9 = cmp Gt v10 0
  if is_true v9:
    tail_local sub_prepare_scrub(v8)
  else:
    v11 = record(hollow, [lit#16])
    v12 = call_local hollow_to_json(v11)
    v13 = call_rt gleam@json:to_string/1(v12)
    v14 = record(awl_outcome_failure, [lit#17, v13])
    v15 = record(error, [v14])
    return v15
== fn sub_prepare_scrub/1 origin=substep(prepare.scrub) ==
  sig: (prepare_dataset.Batch) -> Result(prepare_dataset.PrepareDatasetOutcome, AwlError)
  v1 = field(v0, 2)
  v2 = call_local clean_activity(v1)
  v3 = call_rt aion@duration:milliseconds/1(600000) live_after=[v2]
  v4 = call_rt aion@activity:timeout/2(v2, v3)
  v5 = call_rt aion@activity:task_queue/2(v4, lit#18)
  v6 = call_rt aion@activity:node/2(v5, lit#19)
  v7 = call_rt aion@workflow:run/1(v6)
  v8 = call_rt aion@awl@error:map_activity_error/1(v7)
  v9 = try_bind v8
  v11 = field(v9, 1)
  v10 = cmp Gt v11 0
  if is_true v10:
    v12 = field(v9, 2)
    v13 = field(v9, 1)
    v14 = record(prepared, [v12, v13])
    v15 = record(prepared_outcome, [v14])
    v16 = record(ok, [v15])
    return v16
  else:
    v17 = record(hollow, [lit#20])
    v18 = call_local hollow_to_json(v17)
    v19 = call_rt gleam@json:to_string/1(v18)
    v20 = record(awl_outcome_failure, [lit#21, v19])
    v21 = record(error, [v20])
    return v21
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
  T-DEAD
