module prepare_dataset source=prepare_dataset.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  sub_prepare_fetch_batch:
    aion@activity:timeout/2 [activities] (v1, v2)
    aion@activity:task_queue/2 [activities] (v3, lit#14)
    aion@activity:node/2 [activities] (v4, lit#15)
    aion@workflow:run/1 [activities] (v5)
  sub_prepare_scrub:
    aion@activity:timeout/2 [activities] (v2, v3)
    aion@activity:task_queue/2 [activities] (v4, lit#18)
    aion@activity:node/2 [activities] (v5, lit#19)
    aion@workflow:run/1 [activities] (v6)
== durable families == activities
== atoms ==
  [0] batch
  [1] prepared
  [2] hollow
  [3] clean_input
  [4] fetch_input
  [5] prepare_dataset_input
  [6] prepared_outcome
  [7] awl_outcome_failure
  [8] error
  [9] ok
== literals ==
  [0] "rows"
  [1] "path"
  [2] "path"
  [3] "rows"
  [4] "reason"
  [5] "path"
  [6] "source"
  [7] "source"
  [8] "prepared"
  [9] "outcome"
  [10] ""
  [11] "PrepareDatasetOutcome"
  [12] "prepared"
  [13] "payload"
  [14] "data"
  [15] "shell"
  [16] "no rows survived"
  [17] "hollow_source"
  [18] "data"
  [19] "shell"
  [20] "no rows survived"
  [21] "hollow_source"
== types ==
  record Batch tag=batch
    rows: int
    path: string
  record Prepared tag=prepared
    path: string
    rows: int
  record Hollow tag=hollow
    reason: string
  record CleanInput tag=clean_input
    path: string
  record FetchInput tag=fetch_input
    source: string
  record PrepareDatasetInput tag=prepare_dataset_input
    source: string
  union PrepareDatasetOutcome
    prepared -> prepared_outcome(ref(Prepared))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=prepare_dataset_input_codec output=prepare_dataset_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(prepare_dataset.PrepareDatasetInput, prepare_dataset.PrepareDatasetOutcome, AwlError)
  T-DEF name="prepare_dataset" input=prepare_dataset_input_codec output=prepare_dataset_outcome_codec
== fn execute/1 origin=execute ==
  sig: (prepare_dataset.PrepareDatasetInput) -> Result(prepare_dataset.PrepareDatasetOutcome, AwlError)
  T-EXEC fields=[source:String] entry=step_prepare args=[0]
== fn batch_codec/0 origin=codec_template(RecordTrio, Batch, record#0) ==
  sig: () -> Codec(prepare_dataset.Batch)
  v0 = make_closure batch_to_json captures=[]
  v1 = call_local batch_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn batch_to_json/1 origin=codec_template(RecordTrio, Batch, record#0) ==
  sig: (prepare_dataset.Batch) -> Json
  v1 = field(v0, 1)
  v2 = field(v0, 2)
  v3 = json_obj {"rows": v1|>awlc.int_to_json, "path": v2|>awlc.string_to_json}
  return v3
== fn batch_decoder/0 origin=codec_template(RecordTrio, Batch, record#0) ==
  sig: () -> Decoder(prepare_dataset.Batch)
  v0 = call_rt aion@awl@codec:int_decoder/0()
  v1 = make_closure batch_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn batch_decoder$0/1 origin=lifted(batch_decoder, #0) ==
  sig: (Int) -> Decoder(prepare_dataset.Batch)
  v1 = call_rt aion@awl@codec:string_decoder/0() live_after=[v0]
  v2 = make_closure batch_decoder$1 captures=[v0]
  tail_rt gleam@dynamic@decode:field/3(lit#1, v1, v2)
== fn batch_decoder$1/2 origin=lifted(batch_decoder, #1) ==
  sig: (String, Int) -> Decoder(prepare_dataset.Batch)
  v2 = record(batch, [v1, v0])
  tail_rt gleam@dynamic@decode:success/1(v2)
