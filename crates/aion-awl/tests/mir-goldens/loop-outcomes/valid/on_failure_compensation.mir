== types ==
  record Assets tag=assets
    urls: list(string)
    count: int
  record PublishedOk tag=published_ok
    count: int
  record PublishFailed tag=publish_failed
    reason: string
  record DeleteAssetsInput tag=delete_assets_input
    assets: ref(Assets)
  record PushLiveInput tag=push_live_input
    assets: ref(Assets)
  record RenderInput tag=render_input
    bundle: string
  record PublishAssetsInput tag=publish_assets_input
    bundle: string
  union PublishAssetsOutcome
    published -> published_outcome(ref(PublishedOk))
