module publish_assets source=publish_assets.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_render:
    aion@activity:timeout/2 [activities] (v1, v2)
    aion@activity:task_queue/2 [activities] (v3, lit#13)
    aion@activity:node/2 [activities] (v4, lit#14)
    aion@workflow:run/1 [activities] (v5)
  step_publish:
    aion@activity:retry/2 [activities] (v1, v4)
    aion@activity:timeout/2 [activities] (v5, v6)
    aion@activity:task_queue/2 [activities] (v7, lit#15)
    aion@activity:node/2 [activities] (v8, lit#16)
    aion@workflow:run/1 [activities] (v9)
  publish_on_failure:
    aion@activity:timeout/2 [activities] (v25, v26)
    aion@activity:task_queue/2 [activities] (v27, lit#19)
    aion@activity:node/2 [activities] (v28, lit#20)
    aion@workflow:run/1 [activities] (v29)
