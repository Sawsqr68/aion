== fn step_render/1 origin=region(render) ==
  sig: (String) -> Result(publish_assets.PublishAssetsOutcome, AwlError)
  v1 = call_local render_activity(v0)
  v2 = call_rt aion@duration:milliseconds/1(900000) live_after=[v1]
  v3 = call_rt aion@activity:timeout/2(v1, v2)
  v4 = call_rt aion@activity:task_queue/2(v3, lit#13)
  v5 = call_rt aion@activity:node/2(v4, lit#14)
  v6 = call_rt aion@workflow:run/1(v5)
  v7 = call_rt aion@awl@error:map_activity_error/1(v6)
  v8 = try_bind v7
  tail_local step_publish(v8)
== fn step_publish/1 origin=chain_step(render.publish) ==
  sig: (publish_assets.Assets) -> Result(publish_assets.PublishAssetsOutcome, AwlError)
  v1 = call_local push_live_activity(v0) live_after=[v0]
  v2 = call_rt aion@duration:milliseconds/1(15000) live_after=[v0, v1]
  v3 = record(fixed, [v2])
  v4 = record(retry_policy, [3, v3])
  v5 = call_rt aion@activity:retry/2(v1, v4) live_after=[v0]
  v6 = call_rt aion@duration:milliseconds/1(300000) live_after=[v0, v5]
  v7 = call_rt aion@activity:timeout/2(v5, v6) live_after=[v0]
  v8 = call_rt aion@activity:task_queue/2(v7, lit#15) live_after=[v0]
  v9 = call_rt aion@activity:node/2(v8, lit#16) live_after=[v0]
  v10 = call_rt aion@workflow:run/1(v9) live_after=[v0]
  v11 = call_rt aion@awl@error:map_activity_error/1(v10) live_after=[v0]
  if is_tagged v11 ok/2:
    v12 = field(v11, 1)
    v14 = field(v12, 2)
    v13 = cmp Gt v14 0
    if is_true v13:
      v15 = field(v12, 2)
      v16 = record(published_ok, [v15])
      v17 = record(published_outcome, [v16])
      v18 = record(ok, [v17])
      return v18
    else:
      v19 = record(publish_failed, [lit#17])
      v20 = call_local publish_failed_to_json(v19)
      v21 = call_rt gleam@json:to_string/1(v20)
      v22 = record(awl_outcome_failure, [lit#18, v21])
      v23 = record(error, [v22])
      return v23
  else:
    tail_local publish_on_failure(v0)
== fn publish_on_failure/1 origin=compensation(publish) ==
  sig: (publish_assets.Assets) -> Result(publish_assets.PublishAssetsOutcome, AwlError)
  v25 = call_local delete_assets_activity(v24)
  v26 = call_rt aion@duration:milliseconds/1(300000) live_after=[v25]
  v27 = call_rt aion@activity:timeout/2(v25, v26)
  v28 = call_rt aion@activity:task_queue/2(v27, lit#19)
  v29 = call_rt aion@activity:node/2(v28, lit#20)
  v30 = call_rt aion@workflow:run/1(v29)
  v31 = call_rt aion@awl@error:map_activity_error/1(v30)
  v32 = try_bind v31
  v33 = record(publish_failed, [lit#21])
  v34 = call_local publish_failed_to_json(v33)
  v35 = call_rt gleam@json:to_string/1(v34)
  v36 = record(awl_outcome_failure, [lit#22, v35])
  v37 = record(error, [v36])
  return v37
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
  T-DEAD
