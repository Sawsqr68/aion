== types ==
  record Brief tag=brief
    acceptance_criteria: nullable(list(string)) optional
    statement: string
    title: string
  record RunConfig tag=run_config
    base_branch: string
    gate_commands: list(string)
    lenses: list(ref(Lens))
    max_fix_cycles: int
    repo_root: string
  record Workspace tag=workspace
    path: string
    branch: string
    base_commit: string
  record ScoutReport tag=scout_report
    summary: string
    pointers: list(string)
  record BuildWarmth tag=build_warmth
    warmed: bool
    detail: string
  record Round tag=round
    summary: string
    gates_green: bool
  record Lens tag=lens
    name: string
    charter: string
  record LensVerdict tag=lens_verdict
    lens: string
    blocking: bool
    reject_reason: nullable(string) optional
  record Landed tag=landed
    branch: string
    fix_cycles: int
    first_pass: bool
    summary: string
  record Rejected tag=rejected
    branch: string
    verdicts: list(ref(LensVerdict))
  record Exhausted tag=exhausted
    reason: string
    cycles_spent: int
  record FixRoundInput tag=fix_round_input
    brief: ref(Brief)
    scout: ref(ScoutReport)
    workspace: ref(Workspace)
    prior: ref(Round)
  record ProvisionInput tag=provision_input
    repo_root: string
    base_branch: string
    brief: ref(Brief)
  record ReviewLensInput tag=review_lens_input
    lens: ref(Lens)
    workspace: ref(Workspace)
    round: ref(Round)
  record ScoutInput tag=scout_input
    brief: ref(Brief)
    workspace: ref(Workspace)
  record WarmBuildInput tag=warm_build_input
    workspace: ref(Workspace)
    gates: list(string)
  record DevBriefInput tag=dev_brief_input
    brief: ref(Brief)
    config: ref(RunConfig)
  union DevBriefOutcome
    landed -> landed_outcome(ref(Landed))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=dev_brief_input_codec output=dev_brief_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(dev_brief.DevBriefInput, dev_brief.DevBriefOutcome, AwlError)
  T-DEF name="dev_brief" input=dev_brief_input_codec output=dev_brief_outcome_codec
== fn execute/1 origin=execute ==
  sig: (dev_brief.DevBriefInput) -> Result(dev_brief.DevBriefOutcome, AwlError)
  T-EXEC fields=[brief:dev_brief.Brief, config:dev_brief.RunConfig] entry=step_provision args=[0, 1]
