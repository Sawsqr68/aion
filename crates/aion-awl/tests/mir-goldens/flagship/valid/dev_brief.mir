module dev_brief source=dev_brief.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_provision:
    aion@activity:retry/2 [activities] (v4, v7)
    aion@activity:timeout/2 [activities] (v8, v9)
    aion@activity:task_queue/2 [activities] (v10, lit#59)
    aion@activity:node/2 [activities] (v11, lit#60)
    aion@workflow:run/1 [activities] (v12)
  step_scout:
    aion@activity:timeout/2 [activities] (v3, v4)
    aion@activity:task_queue/2 [activities] (v5, lit#61)
    aion@activity:node/2 [activities] (v6, lit#62)
    aion@activity:timeout/2 [activities] (v9, v10)
    aion@activity:task_queue/2 [activities] (v11, lit#63)
    aion@activity:node/2 [activities] (v12, lit#64)
    aion@workflow:all/1 [activities] (v14)
  step_review:
    aion@workflow:map/2 [activities] (v4, v5)
  fix_cycle_loop_0:
    aion@activity:timeout/2 [activities] (v6, v7)
    aion@activity:task_queue/2 [activities] (v8, lit#67)
    aion@activity:node/2 [activities] (v9, lit#68)
    aion@workflow:run/1 [activities] (v10)
  review_fork_0:
    aion@activity:timeout/2 [activities] (v3, v4)
    aion@activity:task_queue/2 [activities] (v5, lit#71)
    aion@activity:node/2 [activities] (v6, lit#72)
