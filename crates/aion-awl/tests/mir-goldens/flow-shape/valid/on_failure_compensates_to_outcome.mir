module compensate_to_outcome source=compensate_to_outcome.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_publish_it:
    aion@activity:task_queue/2 [activities] (v1, lit#11)
    aion@workflow:run/1 [activities] (v2)
  publish_it_on_failure:
    aion@activity:task_queue/2 [activities] (v11, lit#12)
    aion@workflow:run/1 [activities] (v12)
== durable families == activities
== atoms ==
  [0] receipt
  [1] cleaned
  [2] fail_publish_input
  [3] snapshot_input
  [4] compensate_to_outcome_input
  [5] shipped_outcome
  [6] ok
  [7] awl_outcome_failure
  [8] error
== literals ==
  [0] "url"
  [1] "reason"
  [2] "target"
  [3] "target"
  [4] "target"
  [5] "shipped"
  [6] "outcome"
  [7] ""
  [8] "CompensateToOutcomeOutcome"
  [9] "shipped"
  [10] "payload"
  [11] "shell"
  [12] "shell"
  [13] "publish failed; snapshot taken"
  [14] "cleaned"
== types ==
  record Receipt tag=receipt
    url: string
  record Cleaned tag=cleaned
    reason: string
  record FailPublishInput tag=fail_publish_input
    target: string
  record SnapshotInput tag=snapshot_input
    target: string
  record CompensateToOutcomeInput tag=compensate_to_outcome_input
    target: string
  union CompensateToOutcomeOutcome
    shipped -> shipped_outcome(ref(Receipt))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=compensate_to_outcome_input_codec output=compensate_to_outcome_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(compensate_to_outcome.CompensateToOutcomeInput, compensate_to_outcome.CompensateToOutcomeOutcome, AwlError)
  T-DEF name="compensate_to_outcome" input=compensate_to_outcome_input_codec output=compensate_to_outcome_outcome_codec
== fn execute/1 origin=execute ==
  sig: (compensate_to_outcome.CompensateToOutcomeInput) -> Result(compensate_to_outcome.CompensateToOutcomeOutcome, AwlError)
  T-EXEC fields=[target:String] entry=step_publish_it args=[0]
== fn receipt_codec/0 origin=codec_template(RecordTrio, Receipt, record#0) ==
  sig: () -> Codec(compensate_to_outcome.Receipt)
  v0 = make_closure receipt_to_json captures=[]
  v1 = call_local receipt_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn receipt_to_json/1 origin=codec_template(RecordTrio, Receipt, record#0) ==
  sig: (compensate_to_outcome.Receipt) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"url": v1|>awlc.string_to_json}
  return v2
== fn receipt_decoder/0 origin=codec_template(RecordTrio, Receipt, record#0) ==
  sig: () -> Decoder(compensate_to_outcome.Receipt)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure receipt_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn receipt_decoder$0/1 origin=lifted(receipt_decoder, #0) ==
  sig: (String) -> Decoder(compensate_to_outcome.Receipt)
  v1 = record(receipt, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
