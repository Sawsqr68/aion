  sig: (compensate_to_outcome.CompensateToOutcomeOutcome) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"outcome": lit#5|>awlc.string_to_json, "payload": v1|>receipt_to_json}
  return v2
== fn compensate_to_outcome_outcome_decoder/0 origin=codec_template(UnionTrio, CompensateToOutcomeOutcome, union#5) ==
  sig: () -> Decoder(compensate_to_outcome.CompensateToOutcomeOutcome)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure compensate_to_outcome_outcome_decoder$outcome captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#6, v0, v1)
== fn compensate_to_outcome_outcome_decoder$outcome/1 origin=lifted(compensate_to_outcome_outcome_decoder, #0) ==
  sig: (String) -> Decoder(compensate_to_outcome.CompensateToOutcomeOutcome)
  if cmp Eq v0 lit#9:
    v3 = call_local receipt_decoder()
    v4 = make_closure compensate_to_outcome_outcome_decoder$arm0 captures=[]
    tail_rt gleam@dynamic@decode:field/3(lit#10, v3, v4)
  else:
    v1 = record(receipt, [lit#7])
    v2 = record(shipped_outcome, [v1])
    tail_rt gleam@dynamic@decode:failure/2(v2, lit#8)
== fn compensate_to_outcome_outcome_decoder$arm0/1 origin=lifted(compensate_to_outcome_outcome_decoder, #1) ==
  sig: (compensate_to_outcome.Receipt) -> Decoder(compensate_to_outcome.CompensateToOutcomeOutcome)
  v1 = record(shipped_outcome, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn fail_publish_activity/1 origin=activity_wrapper(fail_publish, raw=false) ==
  sig: (String) -> Activity(compensate_to_outcome.FailPublishInput, compensate_to_outcome.Receipt)
  T-ACT action=fail_publish input_codec=fail_publish_input_codec return=receipt_codec
== fn snapshot_activity/1 origin=activity_wrapper(snapshot, raw=false) ==
  sig: (String) -> Activity(compensate_to_outcome.SnapshotInput, compensate_to_outcome.Cleaned)
  T-ACT action=snapshot input_codec=snapshot_input_codec return=cleaned_codec
== fn step_publish_it/1 origin=region(publish_it) ==
  sig: (String) -> Result(compensate_to_outcome.CompensateToOutcomeOutcome, AwlError)
  v1 = call_local fail_publish_activity(v0) live_after=[v0]
  v2 = call_rt aion@activity:task_queue/2(v1, lit#11) live_after=[v0]
  v3 = call_rt aion@workflow:run/1(v2) live_after=[v0]
  v4 = call_rt aion@awl@error:map_activity_error/1(v3) live_after=[v0]
  if is_tagged v4 ok/2:
    v5 = field(v4, 1)
    v6 = field(v5, 1)
    v7 = record(receipt, [v6])
    v8 = record(shipped_outcome, [v7])
    v9 = record(ok, [v8])
    return v9
  else:
    tail_local publish_it_on_failure(v0)
== fn publish_it_on_failure/1 origin=compensation(publish_it) ==
  sig: (String) -> Result(compensate_to_outcome.CompensateToOutcomeOutcome, AwlError)
  v11 = call_local snapshot_activity(v10)
  v12 = call_rt aion@activity:task_queue/2(v11, lit#12)
  v13 = call_rt aion@workflow:run/1(v12)
  v14 = call_rt aion@awl@error:map_activity_error/1(v13)
  v15 = try_bind v14
  v16 = record(cleaned, [lit#13])
  v17 = call_local cleaned_to_json(v16)
  v18 = call_rt gleam@json:to_string/1(v17)
  v19 = record(awl_outcome_failure, [lit#14, v18])
  v20 = record(error, [v19])
  return v20
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
  T-DEAD
