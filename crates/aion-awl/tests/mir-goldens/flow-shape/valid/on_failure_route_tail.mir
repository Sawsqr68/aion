  sig: (publish_with_cleanup.PublishWithCleanupOutcome) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"outcome": lit#5|>awlc.string_to_json, "payload": v1|>receipt_to_json}
  return v2
== fn publish_with_cleanup_outcome_decoder/0 origin=codec_template(UnionTrio, PublishWithCleanupOutcome, union#5) ==
  sig: () -> Decoder(publish_with_cleanup.PublishWithCleanupOutcome)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure publish_with_cleanup_outcome_decoder$outcome captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#6, v0, v1)
== fn publish_with_cleanup_outcome_decoder$outcome/1 origin=lifted(publish_with_cleanup_outcome_decoder, #0) ==
  sig: (String) -> Decoder(publish_with_cleanup.PublishWithCleanupOutcome)
  if cmp Eq v0 lit#9:
    v3 = call_local receipt_decoder()
    v4 = make_closure publish_with_cleanup_outcome_decoder$arm0 captures=[]
    tail_rt gleam@dynamic@decode:field/3(lit#10, v3, v4)
  else:
    v1 = record(receipt, [lit#7])
    v2 = record(shipped_outcome, [v1])
    tail_rt gleam@dynamic@decode:failure/2(v2, lit#8)
== fn publish_with_cleanup_outcome_decoder$arm0/1 origin=lifted(publish_with_cleanup_outcome_decoder, #1) ==
  sig: (publish_with_cleanup.Receipt) -> Decoder(publish_with_cleanup.PublishWithCleanupOutcome)
  v1 = record(shipped_outcome, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn publish_activity/1 origin=activity_wrapper(publish, raw=false) ==
  sig: (String) -> Activity(publish_with_cleanup.PublishInput, publish_with_cleanup.Receipt)
  T-ACT action=publish input_codec=publish_input_codec return=receipt_codec
== fn snapshot_activity/1 origin=activity_wrapper(snapshot, raw=false) ==
  sig: (String) -> Activity(publish_with_cleanup.SnapshotInput, publish_with_cleanup.Receipt)
  T-ACT action=snapshot input_codec=snapshot_input_codec return=receipt_codec
== fn step_publish_it/1 origin=region(publish_it) ==
  sig: (String) -> Result(publish_with_cleanup.PublishWithCleanupOutcome, AwlError)
  v1 = call_local publish_activity(v0) live_after=[v0]
  v2 = call_rt aion@activity:task_queue/2(v1, lit#11) live_after=[v0]
  v3 = call_rt aion@workflow:run/1(v2) live_after=[v0]
  v4 = call_rt aion@awl@error:map_activity_error/1(v3) live_after=[v0]
  if is_tagged v4 ok/2:
    v5 = field(v4, 1)
    v6 = record(failed, [lit#12])
    v7 = call_local failed_to_json(v6)
    v8 = call_rt gleam@json:to_string/1(v7)
    v9 = record(awl_outcome_failure, [lit#13, v8])
    v10 = record(error, [v9])
    return v10
  else:
    tail_local publish_it_on_failure(v0)
== fn publish_it_on_failure/1 origin=compensation(publish_it) ==
  sig: (String) -> Result(publish_with_cleanup.PublishWithCleanupOutcome, AwlError)
  v12 = call_local snapshot_activity(v11)
  v13 = call_rt aion@activity:task_queue/2(v12, lit#14)
  v14 = call_rt aion@workflow:run/1(v13)
  v15 = call_rt aion@awl@error:map_activity_error/1(v14)
  v16 = try_bind v15
  v17 = record(failed, [lit#15])
  v18 = call_local failed_to_json(v17)
  v19 = call_rt gleam@json:to_string/1(v18)
  v20 = record(awl_outcome_failure, [lit#16, v19])
  v21 = record(error, [v20])
  return v21
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
  T-DEAD
