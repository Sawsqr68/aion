  sig: () -> Codec(publish_with_cleanup.PublishWithCleanupOutcome)
  v0 = make_closure publish_with_cleanup_outcome_to_json captures=[]
  v1 = call_local publish_with_cleanup_outcome_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
