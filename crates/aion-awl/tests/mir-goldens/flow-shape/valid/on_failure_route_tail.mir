module publish_with_cleanup source=publish_with_cleanup.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_publish_it:
    aion@activity:task_queue/2 [activities] (v1, lit#11)
    aion@workflow:run/1 [activities] (v2)
  publish_it_on_failure:
    aion@activity:task_queue/2 [activities] (v12, lit#14)
    aion@workflow:run/1 [activities] (v13)
== durable families == activities
== atoms ==
  [0] receipt
  [1] failed
  [2] publish_input
  [3] snapshot_input
  [4] publish_with_cleanup_input
  [5] shipped_outcome
  [6] ok
  [7] awl_outcome_failure
  [8] error
== literals ==
  [0] "url"
  [1] "reason"
  [2] "target"
  [3] "target"
  [4] "target"
  [5] "shipped"
  [6] "outcome"
  [7] ""
  [8] "PublishWithCleanupOutcome"
  [9] "shipped"
  [10] "payload"
  [11] "shell"
  [12] "deliberately routed failure outcome"
  [13] "dead_end"
  [14] "shell"
  [15] "publish failed; snapshot taken"
  [16] "cleaned"
== types ==
  record Receipt tag=receipt
    url: string
  record Failed tag=failed
    reason: string
  record PublishInput tag=publish_input
    target: string
  record SnapshotInput tag=snapshot_input
    target: string
  record PublishWithCleanupInput tag=publish_with_cleanup_input
    target: string
  union PublishWithCleanupOutcome
    shipped -> shipped_outcome(ref(Receipt))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=publish_with_cleanup_input_codec output=publish_with_cleanup_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(publish_with_cleanup.PublishWithCleanupInput, publish_with_cleanup.PublishWithCleanupOutcome, AwlError)
  T-DEF name="publish_with_cleanup" input=publish_with_cleanup_input_codec output=publish_with_cleanup_outcome_codec
== fn execute/1 origin=execute ==
  sig: (publish_with_cleanup.PublishWithCleanupInput) -> Result(publish_with_cleanup.PublishWithCleanupOutcome, AwlError)
  T-EXEC fields=[target:String] entry=step_publish_it args=[0]
== fn receipt_codec/0 origin=codec_template(RecordTrio, Receipt, record#0) ==
  sig: () -> Codec(publish_with_cleanup.Receipt)
  v0 = make_closure receipt_to_json captures=[]
  v1 = call_local receipt_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn receipt_to_json/1 origin=codec_template(RecordTrio, Receipt, record#0) ==
  sig: (publish_with_cleanup.Receipt) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"url": v1|>awlc.string_to_json}
  return v2
== fn receipt_decoder/0 origin=codec_template(RecordTrio, Receipt, record#0) ==
  sig: () -> Decoder(publish_with_cleanup.Receipt)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure receipt_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn receipt_decoder$0/1 origin=lifted(receipt_decoder, #0) ==
  sig: (String) -> Decoder(publish_with_cleanup.Receipt)
  v1 = record(receipt, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
