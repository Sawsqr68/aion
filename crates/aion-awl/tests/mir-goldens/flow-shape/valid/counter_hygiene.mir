module counter_hygiene source=counter_hygiene.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
== durable families ==
== atoms ==
  [0] counter_hygiene_input
  [1] done_outcome
  [2] awl_visits_exceeded
  [3] error
  [4] ok
== literals ==
  [0] "awl_visits_again_188"
  [1] "done"
  [2] "outcome"
  [3] ""
  [4] "CounterHygieneOutcome"
  [5] "done"
  [6] "payload"
  [7] "step `again` exceeded its `max … visits` bound at line 8, column 3"
== types ==
  record CounterHygieneInput tag=counter_hygiene_input
    awl_visits_again_188: string
  union CounterHygieneOutcome
    done -> done_outcome(string)
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=counter_hygiene_input_codec output=counter_hygiene_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(counter_hygiene.CounterHygieneInput, counter_hygiene.CounterHygieneOutcome, AwlError)
  T-DEF name="counter_hygiene" input=counter_hygiene_input_codec output=counter_hygiene_outcome_codec
== fn execute/1 origin=execute ==
  sig: (counter_hygiene.CounterHygieneInput) -> Result(counter_hygiene.CounterHygieneOutcome, AwlError)
  T-EXEC fields=[awl_visits_again_188:String] entry=step_again args=[0, zero]
== fn counter_hygiene_input_codec/0 origin=codec_template(RecordTrio, CounterHygieneInput, record#0) ==
  sig: () -> Codec(counter_hygiene.CounterHygieneInput)
  v0 = make_closure counter_hygiene_input_to_json captures=[]
  v1 = call_local counter_hygiene_input_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn counter_hygiene_input_to_json/1 origin=codec_template(RecordTrio, CounterHygieneInput, record#0) ==
  sig: (counter_hygiene.CounterHygieneInput) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"awl_visits_again_188": v1|>awlc.string_to_json}
  return v2
== fn counter_hygiene_input_decoder/0 origin=codec_template(RecordTrio, CounterHygieneInput, record#0) ==
  sig: () -> Decoder(counter_hygiene.CounterHygieneInput)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure counter_hygiene_input_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn counter_hygiene_input_decoder$0/1 origin=lifted(counter_hygiene_input_decoder, #0) ==
  sig: (String) -> Decoder(counter_hygiene.CounterHygieneInput)
  v1 = record(counter_hygiene_input, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn counter_hygiene_outcome_codec/0 origin=codec_template(UnionTrio, CounterHygieneOutcome, union#1) ==
  sig: () -> Codec(counter_hygiene.CounterHygieneOutcome)
  v0 = make_closure counter_hygiene_outcome_to_json captures=[]
  v1 = call_local counter_hygiene_outcome_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn counter_hygiene_outcome_to_json/1 origin=codec_template(UnionTrio, CounterHygieneOutcome, union#1) ==
  sig: (counter_hygiene.CounterHygieneOutcome) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"outcome": lit#1|>awlc.string_to_json, "payload": v1|>awlc.string_to_json}
  return v2
== fn counter_hygiene_outcome_decoder/0 origin=codec_template(UnionTrio, CounterHygieneOutcome, union#1) ==
  sig: () -> Decoder(counter_hygiene.CounterHygieneOutcome)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure counter_hygiene_outcome_decoder$outcome captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#2, v0, v1)
== fn counter_hygiene_outcome_decoder$outcome/1 origin=lifted(counter_hygiene_outcome_decoder, #0) ==
  sig: (String) -> Decoder(counter_hygiene.CounterHygieneOutcome)
  if cmp Eq v0 lit#5:
    v2 = call_rt aion@awl@codec:string_decoder/0()
    v3 = make_closure counter_hygiene_outcome_decoder$arm0 captures=[]
    tail_rt gleam@dynamic@decode:field/3(lit#6, v2, v3)
  else:
    v1 = record(done_outcome, [lit#3])
    tail_rt gleam@dynamic@decode:failure/2(v1, lit#4)
== fn counter_hygiene_outcome_decoder$arm0/1 origin=lifted(counter_hygiene_outcome_decoder, #1) ==
  sig: (String) -> Decoder(counter_hygiene.CounterHygieneOutcome)
  v1 = record(done_outcome, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn step_again/2 origin=region(again) ==
  sig: (String, Int) -> Result(counter_hygiene.CounterHygieneOutcome, AwlError)
  v2 = increment v1
  if cmp Gt v2 2:
    v3 = record(awl_visits_exceeded, [lit#7])
    v4 = record(error, [v3])
    return v4
  else:
    v5 = record(done_outcome, [v0])
    v6 = record(ok, [v5])
    return v6
