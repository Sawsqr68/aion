== types ==
  record Task tag=task
    title: string
    goal: string
  record Complete tag=complete
    summary: string
  record Incomplete tag=incomplete
    reason: string
  record WorkItem tag=work_item
    id: string
    title: string
    goal: string
  record ItemVerdict tag=item_verdict
    verdict: string
    item_id: string
  record AgentOut tag=agent_out
    items: list(ref(WorkItem))
    summary: string
    notes_dir: string
  record RunAgentInput tag=run_agent_input
    instructions: string
    output_schema: string
    prompt: string
  record RunReviewInput tag=run_review_input
    item: ref(WorkItem)
    note: string
  record DevFlowInput tag=dev_flow_input
    task: ref(Task)
  union DevFlowOutcome
    done -> done_outcome(ref(Complete))
  record AionInternalAwlChildDevFlowWave0Input tag=aion_internal_awl_child_dev_flow_wave0_input
    item: ref(WorkItem)
    state: ref(AgentOut)
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=dev_flow_input_codec output=dev_flow_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(dev_flow.DevFlowInput, dev_flow.DevFlowOutcome, AwlError)
  T-DEF name="dev_flow" input=dev_flow_input_codec output=dev_flow_outcome_codec
== fn execute/1 origin=execute ==
  sig: (dev_flow.DevFlowInput) -> Result(dev_flow.DevFlowOutcome, AwlError)
  T-EXEC fields=[task:dev_flow.Task] entry=step_plan args=[zero, 0]
