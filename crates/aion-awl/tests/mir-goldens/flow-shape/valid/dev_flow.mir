module dev_flow source=dev_flow.awl
exports: run/1, definition/0, execute/1, aion_internal_awl_child_dev_flow_wave_0_run/1
== effect schedule ==
  step_plan:
    aion@activity:task_queue/2 [activities] (v3, lit#31)
    aion@workflow:run/1 [activities] (v4)
  step_fold:
    aion@activity:task_queue/2 [activities] (v6, lit#36)
    aion@workflow:run/1 [activities] (v7)
  awl_sf_dev_item_step_develop:
    aion@activity:task_queue/2 [activities] (v5, lit#39)
    aion@workflow:run/1 [activities] (v6)
  awl_sf_dev_item_step_review:
    aion@activity:task_queue/2 [activities] (v8, lit#41)
    aion@workflow:run/1 [activities] (v9)
  wave_fanout_0:
    aion@workflow:spawn/6 [children] (lit#32, v4, v3, v5, v6, v7)
  wave_fanout_1:
    aion@child:await/1 [children] (v2)
