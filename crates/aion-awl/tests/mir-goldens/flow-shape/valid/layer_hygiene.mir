module layer_hygiene source=layer_hygiene.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_root:
    aion@activity:task_queue/2 [activities] (v1, lit#13)
    aion@workflow:run/1 [activities] (v2)
  step_left:
    aion@activity:task_queue/2 [activities] (v1, lit#14)
    aion@activity:task_queue/2 [activities] (v3, lit#15)
    aion@workflow:all/1 [activities] (v5)
  step_merge:
    aion@activity:task_queue/2 [activities] (v2, lit#18)
    aion@workflow:run/1 [activities] (v3)
== durable families == activities
== atoms ==
  [0] left_input
  [1] merge_input
  [2] right_input
  [3] root_input
  [4] layer_hygiene_input
  [5] done_outcome
  [6] ok
== literals ==
  [0] "value"
  [1] "left"
  [2] "right"
  [3] "value"
  [4] "value"
  [5] "seed"
  [6] "awl_layer"
  [7] "done"
  [8] "outcome"
  [9] ""
  [10] "LayerHygieneOutcome"
  [11] "done"
  [12] "payload"
  [13] "local"
  [14] "local"
  [15] "local"
  [16] "left"
  [17] "right"
  [18] "local"
== types ==
  record LeftInput tag=left_input
    value: string
  record MergeInput tag=merge_input
    left: string
    right: string
  record RightInput tag=right_input
    value: string
  record RootInput tag=root_input
    value: string
  record LayerHygieneInput tag=layer_hygiene_input
    seed: string
    awl_layer: string
  union LayerHygieneOutcome
    done -> done_outcome(string)
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=layer_hygiene_input_codec output=layer_hygiene_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(layer_hygiene.LayerHygieneInput, layer_hygiene.LayerHygieneOutcome, AwlError)
  T-DEF name="layer_hygiene" input=layer_hygiene_input_codec output=layer_hygiene_outcome_codec
== fn execute/1 origin=execute ==
  sig: (layer_hygiene.LayerHygieneInput) -> Result(layer_hygiene.LayerHygieneOutcome, AwlError)
  T-EXEC fields=[seed:String, awl_layer:String] entry=step_root args=[0]
== fn left_input_codec/0 origin=codec_template(RecordTrio, LeftInput, record#0) ==
  sig: () -> Codec(layer_hygiene.LeftInput)
  v0 = make_closure left_input_to_json captures=[]
  v1 = call_local left_input_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn left_input_to_json/1 origin=codec_template(RecordTrio, LeftInput, record#0) ==
  sig: (layer_hygiene.LeftInput) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"value": v1|>awlc.string_to_json}
  return v2
== fn left_input_decoder/0 origin=codec_template(RecordTrio, LeftInput, record#0) ==
  sig: () -> Decoder(layer_hygiene.LeftInput)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure left_input_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn left_input_decoder$0/1 origin=lifted(left_input_decoder, #0) ==
  sig: (String) -> Decoder(layer_hygiene.LeftInput)
  v1 = record(left_input, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
