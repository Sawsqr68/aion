  sig: (layer_hygiene.LayerHygieneOutcome) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"outcome": lit#7|>awlc.string_to_json, "payload": v1|>awlc.string_to_json}
  return v2
== fn layer_hygiene_outcome_decoder/0 origin=codec_template(UnionTrio, LayerHygieneOutcome, union#5) ==
  sig: () -> Decoder(layer_hygiene.LayerHygieneOutcome)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure layer_hygiene_outcome_decoder$outcome captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#8, v0, v1)
== fn layer_hygiene_outcome_decoder$outcome/1 origin=lifted(layer_hygiene_outcome_decoder, #0) ==
  sig: (String) -> Decoder(layer_hygiene.LayerHygieneOutcome)
  if cmp Eq v0 lit#11:
    v2 = call_rt aion@awl@codec:string_decoder/0()
    v3 = make_closure layer_hygiene_outcome_decoder$arm0 captures=[]
    tail_rt gleam@dynamic@decode:field/3(lit#12, v2, v3)
  else:
    v1 = record(done_outcome, [lit#9])
    tail_rt gleam@dynamic@decode:failure/2(v1, lit#10)
== fn layer_hygiene_outcome_decoder$arm0/1 origin=lifted(layer_hygiene_outcome_decoder, #1) ==
  sig: (String) -> Decoder(layer_hygiene.LayerHygieneOutcome)
  v1 = record(done_outcome, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
