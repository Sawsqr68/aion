  sig: (String) -> Activity(layer_hygiene.RootInput, String)
  T-ACT action=root input_codec=root_input_codec return=awlc.string_codec
== fn left_activity_raw/1 origin=activity_wrapper(left, raw=true) ==
  sig: (String) -> Activity(String, String)
  T-ACTRAW action=left input_codec=left_input_codec
== fn right_activity_raw/1 origin=activity_wrapper(right, raw=true) ==
  sig: (String) -> Activity(String, String)
  T-ACTRAW action=right input_codec=right_input_codec
== fn step_root/1 origin=region(root) ==
  sig: (String) -> Result(layer_hygiene.LayerHygieneOutcome, AwlError)
  v1 = call_local root_activity(v0)
  v2 = call_rt aion@activity:task_queue/2(v1, lit#13)
  v3 = call_rt aion@workflow:run/1(v2)
  v4 = call_rt aion@awl@error:map_activity_error/1(v3)
  v5 = try_bind v4
  tail_local step_left(v5)
== fn step_left/1 origin=chain_step(root.left) ==
  sig: (String) -> Result(layer_hygiene.LayerHygieneOutcome, AwlError)
  v1 = call_local left_activity_raw(v0) live_after=[v0]
  v2 = call_rt aion@activity:task_queue/2(v1, lit#14) live_after=[v0]
  v3 = call_local right_activity_raw(v0) live_after=[v2]
  v4 = call_rt aion@activity:task_queue/2(v3, lit#15) live_after=[v2]
  v5 = list([v2, v4])
  v6 = call_rt aion@workflow:all/1(v5)
  v7 = call_rt aion@awl@error:map_activity_error/1(v6)
  v8 = try_bind v7
  assert_list [v9, v10] = v8
  v11 = call_rt aion@awl@codec:string_codec/0() live_after=[v9, v10]
  v12 = call_rt aion@awl@codec:decoded/3(v11, v9, lit#16) live_after=[v10]
  v13 = try_bind v12 live_after=[v10]
  v14 = call_rt aion@awl@codec:string_codec/0() live_after=[v10, v13]
  v15 = call_rt aion@awl@codec:decoded/3(v14, v10, lit#17) live_after=[v13]
  v16 = try_bind v15 live_after=[v13]
  tail_local step_merge(v13, v16)
== fn step_merge/2 origin=chain_step(root.merge) ==
  sig: (String, String) -> Result(layer_hygiene.LayerHygieneOutcome, AwlError)
  v2 = call_local merge_activity(v0, v1)
  v3 = call_rt aion@activity:task_queue/2(v2, lit#18)
  v4 = call_rt aion@workflow:run/1(v3)
  v5 = call_rt aion@awl@error:map_activity_error/1(v4)
  v6 = try_bind v5
  v7 = record(done_outcome, [v6])
  v8 = record(ok, [v7])
  return v8
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
  T-DEAD
