== fn step_run/1 origin=region(run) ==
  sig: (List(String)) -> Result(temporary_hygiene.TemporaryHygieneOutcome, AwlError)
  v1 = call_rt aion@awl@runtime:index/3(v0, 0, lit#14)
  v2 = try_bind v1
  v3 = call_local echo_activity(v2)
  v4 = call_rt aion@activity:task_queue/2(v3, lit#15)
  v5 = call_rt aion@workflow:run/1(v4)
  v6 = call_rt aion@awl@error:map_activity_error/1(v5)
  v7 = try_bind v6
  v8 = call_local run_loop_0(v7, 0, 2, v7) live_after=[v7]
  v9 = try_bind v8 live_after=[v7]
  v10 = field(v9, 0)
  v11 = field(v9, 1)
  v12 = cmp Eq v10 v7
  if is_true v12:
    v14 = call_rt aion@workflow:id/0() live_after=[v10]
    v15 = call_rt aion@awl@error:map_engine_error/1(v14) live_after=[v10]
    v16 = try_bind v15 live_after=[v10]
    v13 = concat v10 v16
    v17 = record(done_outcome, [v13])
    v18 = record(ok, [v17])
    return v18
  else:
    v20 = call_rt aion@workflow:id/0() live_after=[v10]
    v21 = call_rt aion@awl@error:map_engine_error/1(v20) live_after=[v10]
    v22 = try_bind v21 live_after=[v10]
    v19 = concat v10 v22
    v23 = record(done_outcome, [v19])
    v24 = record(ok, [v23])
    return v24
== fn run_loop_0/4 origin=loop(run#0) ==
  sig: (String, Int, Int, String) -> Result(#(String, Int), AwlError)
  v4 = call_local echo_activity(v0) live_after=[v1, v2, v3]
  v5 = call_rt aion@activity:task_queue/2(v4, lit#16) live_after=[v1, v2, v3]
  v6 = call_rt aion@workflow:run/1(v5) live_after=[v1, v2, v3]
  v7 = call_rt aion@awl@error:map_activity_error/1(v6) live_after=[v1, v2, v3]
  v8 = try_bind v7 live_after=[v1, v2, v3]
  v9 = increment v1
  v12 = cmp Eq v8 v3
  if is_true v12:
    v10 = tuple([v8, v9])
    v11 = record(ok, [v10])
    return v11
  else:
    if cmp Ge v9 v2:
      v10 = tuple([v8, v9])
      v11 = record(ok, [v10])
      return v11
    else:
      tail_local run_loop_0(v8, v9, v2, v3)
