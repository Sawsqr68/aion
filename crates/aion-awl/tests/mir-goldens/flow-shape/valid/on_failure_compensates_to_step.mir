module compensate_to_step source=compensate_to_step.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_charge:
    aion@activity:task_queue/2 [activities] (v1, lit#13)
    aion@workflow:run/1 [activities] (v2)
  step_unwind:
    aion@activity:task_queue/2 [activities] (v1, lit#15)
    aion@workflow:run/1 [activities] (v2)
  charge_on_failure:
    aion@activity:task_queue/2 [activities] (v11, lit#14)
    aion@workflow:run/1 [activities] (v12)
== durable families == activities
== atoms ==
  [0] settlement
  [1] note
  [2] fail_charge_input
  [3] note_failure_input
  [4] refund_input
  [5] compensate_to_step_input
  [6] settled_outcome
  [7] false
  [8] ok
  [9] true
== literals ==
  [0] "order_id"
  [1] "unwound"
  [2] "text"
  [3] "order_id"
  [4] "order_id"
  [5] "order_id"
  [6] "order_id"
  [7] "settled"
  [8] "outcome"
  [9] ""
  [10] "CompensateToStepOutcome"
  [11] "settled"
  [12] "payload"
  [13] "billing"
  [14] "billing"
  [15] "billing"
== types ==
  record Settlement tag=settlement
    order_id: string
    unwound: bool
  record Note tag=note
    text: string
  record FailChargeInput tag=fail_charge_input
    order_id: string
  record NoteFailureInput tag=note_failure_input
    order_id: string
  record RefundInput tag=refund_input
    order_id: string
  record CompensateToStepInput tag=compensate_to_step_input
    order_id: string
  union CompensateToStepOutcome
    settled -> settled_outcome(ref(Settlement))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=compensate_to_step_input_codec output=compensate_to_step_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(compensate_to_step.CompensateToStepInput, compensate_to_step.CompensateToStepOutcome, AwlError)
  T-DEF name="compensate_to_step" input=compensate_to_step_input_codec output=compensate_to_step_outcome_codec
== fn execute/1 origin=execute ==
  sig: (compensate_to_step.CompensateToStepInput) -> Result(compensate_to_step.CompensateToStepOutcome, AwlError)
  T-EXEC fields=[order_id:String] entry=step_charge args=[0]
== fn settlement_codec/0 origin=codec_template(RecordTrio, Settlement, record#0) ==
  sig: () -> Codec(compensate_to_step.Settlement)
  v0 = make_closure settlement_to_json captures=[]
  v1 = call_local settlement_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn settlement_to_json/1 origin=codec_template(RecordTrio, Settlement, record#0) ==
  sig: (compensate_to_step.Settlement) -> Json
  v1 = field(v0, 1)
  v2 = field(v0, 2)
  v3 = json_obj {"order_id": v1|>awlc.string_to_json, "unwound": v2|>awlc.bool_to_json}
  return v3
== fn settlement_decoder/0 origin=codec_template(RecordTrio, Settlement, record#0) ==
  sig: () -> Decoder(compensate_to_step.Settlement)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure settlement_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn settlement_decoder$0/1 origin=lifted(settlement_decoder, #0) ==
  sig: (String) -> Decoder(compensate_to_step.Settlement)
  v1 = call_rt aion@awl@codec:bool_decoder/0() live_after=[v0]
  v2 = make_closure settlement_decoder$1 captures=[v0]
  tail_rt gleam@dynamic@decode:field/3(lit#1, v1, v2)
== fn settlement_decoder$1/2 origin=lifted(settlement_decoder, #1) ==
  sig: (Bool, String) -> Decoder(compensate_to_step.Settlement)
  v2 = record(settlement, [v1, v0])
  tail_rt gleam@dynamic@decode:success/1(v2)
