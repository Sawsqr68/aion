  sig: (compensate_to_step.CompensateToStepOutcome) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"outcome": lit#7|>awlc.string_to_json, "payload": v1|>settlement_to_json}
  return v2
== fn compensate_to_step_outcome_decoder/0 origin=codec_template(UnionTrio, CompensateToStepOutcome, union#6) ==
  sig: () -> Decoder(compensate_to_step.CompensateToStepOutcome)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure compensate_to_step_outcome_decoder$outcome captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#8, v0, v1)
== fn compensate_to_step_outcome_decoder$outcome/1 origin=lifted(compensate_to_step_outcome_decoder, #0) ==
  sig: (String) -> Decoder(compensate_to_step.CompensateToStepOutcome)
  if cmp Eq v0 lit#11:
    v3 = call_local settlement_decoder()
    v4 = make_closure compensate_to_step_outcome_decoder$arm0 captures=[]
    tail_rt gleam@dynamic@decode:field/3(lit#12, v3, v4)
  else:
    v1 = record(settlement, [lit#9, 'false'])
    v2 = record(settled_outcome, [v1])
    tail_rt gleam@dynamic@decode:failure/2(v2, lit#10)
== fn compensate_to_step_outcome_decoder$arm0/1 origin=lifted(compensate_to_step_outcome_decoder, #1) ==
  sig: (compensate_to_step.Settlement) -> Decoder(compensate_to_step.CompensateToStepOutcome)
  v1 = record(settled_outcome, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn fail_charge_activity/1 origin=activity_wrapper(fail_charge, raw=false) ==
  sig: (String) -> Activity(compensate_to_step.FailChargeInput, compensate_to_step.Settlement)
  T-ACT action=fail_charge input_codec=fail_charge_input_codec return=settlement_codec
== fn note_failure_activity/1 origin=activity_wrapper(note_failure, raw=false) ==
  sig: (String) -> Activity(compensate_to_step.NoteFailureInput, compensate_to_step.Note)
  T-ACT action=note_failure input_codec=note_failure_input_codec return=note_codec
== fn refund_activity/1 origin=activity_wrapper(refund, raw=false) ==
  sig: (String) -> Activity(compensate_to_step.RefundInput, compensate_to_step.Settlement)
  T-ACT action=refund input_codec=refund_input_codec return=settlement_codec
== fn step_charge/1 origin=region(charge) ==
  sig: (String) -> Result(compensate_to_step.CompensateToStepOutcome, AwlError)
  v1 = call_local fail_charge_activity(v0) live_after=[v0]
  v2 = call_rt aion@activity:task_queue/2(v1, lit#13) live_after=[v0]
  v3 = call_rt aion@workflow:run/1(v2) live_after=[v0]
  v4 = call_rt aion@awl@error:map_activity_error/1(v3) live_after=[v0]
  if is_tagged v4 ok/2:
    v5 = field(v4, 1)
    v6 = field(v5, 1)
    v7 = record(settlement, [v6, 'false'])
    v8 = record(settled_outcome, [v7])
    v9 = record(ok, [v8])
    return v9
  else:
    tail_local charge_on_failure(v0)
== fn step_unwind/1 origin=region(unwind) ==
  sig: (String) -> Result(compensate_to_step.CompensateToStepOutcome, AwlError)
  v1 = call_local refund_activity(v0)
  v2 = call_rt aion@activity:task_queue/2(v1, lit#15)
  v3 = call_rt aion@workflow:run/1(v2)
  v4 = call_rt aion@awl@error:map_activity_error/1(v3)
  v5 = try_bind v4
  v6 = field(v5, 1)
  v7 = record(settlement, [v6, 'true'])
  v8 = record(settled_outcome, [v7])
  v9 = record(ok, [v8])
  return v9
== fn charge_on_failure/1 origin=compensation(charge) ==
  sig: (String) -> Result(compensate_to_step.CompensateToStepOutcome, AwlError)
  v11 = call_local note_failure_activity(v10) live_after=[v10]
  v12 = call_rt aion@activity:task_queue/2(v11, lit#14) live_after=[v10]
  v13 = call_rt aion@workflow:run/1(v12) live_after=[v10]
  v14 = call_rt aion@awl@error:map_activity_error/1(v13) live_after=[v10]
  v15 = try_bind v14 live_after=[v10]
  tail_local step_unwind(v10)
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
  T-DEAD
