== fn step_gather/1 origin=region(gather) ==
  sig: (String) -> Result(action_param_hygiene.ActionParamHygieneOutcome, AwlError)
  v1 = call_local fetch_text_activity_raw(v0) live_after=[v0]
  v2 = call_rt aion@activity:task_queue/2(v1, lit#9) live_after=[v0]
  v3 = call_local fetch_number_activity_raw(v0) live_after=[v2]
  v4 = call_rt aion@activity:task_queue/2(v3, lit#10) live_after=[v2]
  v5 = list([v2, v4])
  v6 = call_rt aion@workflow:all/1(v5)
  v7 = call_rt aion@awl@error:map_activity_error/1(v6)
  v8 = try_bind v7
  assert_list [v9, v10] = v8
  v11 = call_rt aion@awl@codec:string_codec/0() live_after=[v9, v10]
  v12 = call_rt aion@awl@codec:decoded/3(v11, v9, lit#11) live_after=[v10]
  v13 = try_bind v12 live_after=[v10]
  v14 = call_rt aion@awl@codec:int_codec/0() live_after=[v10, v13]
  v15 = call_rt aion@awl@codec:decoded/3(v14, v10, lit#12) live_after=[v13]
  v16 = try_bind v15 live_after=[v13]
  v17 = record(complete_outcome, [v13])
  v18 = record(ok, [v17])
  return v18
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
