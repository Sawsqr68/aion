module action_param_hygiene source=action_param_hygiene.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_gather:
    aion@activity:task_queue/2 [activities] (v1, lit#9)
    aion@activity:task_queue/2 [activities] (v3, lit#10)
    aion@workflow:all/1 [activities] (v5)
== durable families == activities
== atoms ==
  [0] fetch_number_input
  [1] fetch_text_input
  [2] action_param_hygiene_input
  [3] complete_outcome
  [4] ok
== literals ==
  [0] "value"
  [1] "awl_input_codec"
  [2] "seed"
  [3] "complete"
  [4] "outcome"
  [5] ""
  [6] "ActionParamHygieneOutcome"
  [7] "complete"
  [8] "payload"
  [9] "source"
  [10] "source"
  [11] "fetch_text"
  [12] "fetch_number"
== types ==
  record FetchNumberInput tag=fetch_number_input
    value: string
  record FetchTextInput tag=fetch_text_input
    awl_input_codec: string
  record ActionParamHygieneInput tag=action_param_hygiene_input
    seed: string
  union ActionParamHygieneOutcome
    complete -> complete_outcome(string)
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=action_param_hygiene_input_codec output=action_param_hygiene_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(action_param_hygiene.ActionParamHygieneInput, action_param_hygiene.ActionParamHygieneOutcome, AwlError)
  T-DEF name="action_param_hygiene" input=action_param_hygiene_input_codec output=action_param_hygiene_outcome_codec
== fn execute/1 origin=execute ==
  sig: (action_param_hygiene.ActionParamHygieneInput) -> Result(action_param_hygiene.ActionParamHygieneOutcome, AwlError)
  T-EXEC fields=[seed:String] entry=step_gather args=[0]
