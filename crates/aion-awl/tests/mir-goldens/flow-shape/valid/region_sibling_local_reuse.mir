module sibling_region_locals source=sibling_region_locals.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_text_wave:
    aion@workflow:map/2 [activities] (v1, v2)
  step_number_wave:
    aion@workflow:map/2 [activities] (v0, v1)
  awl_r0_text_wave_step_text_member:
    aion@activity:task_queue/2 [activities] (v1, lit#11)
    aion@workflow:run/1 [activities] (v2)
  awl_r1_number_wave_step_number_member:
    aion@activity:task_queue/2 [activities] (v1, lit#12)
    aion@workflow:run/1 [activities] (v2)
  text_wave_fanout_0:
    aion@activity:task_queue/2 [activities] (v1, lit#9)
  number_wave_fanout_1:
    aion@activity:task_queue/2 [activities] (v1, lit#10)
== durable families == activities
== atoms ==
  [0] keep_number_input
  [1] keep_text_input
  [2] sibling_region_locals_input
  [3] done_outcome
  [4] ok
== literals ==
  [0] "value"
  [1] "value"
  [2] "texts"
  [3] "numbers"
  [4] "done"
  [5] "outcome"
  [6] "SiblingRegionLocalsOutcome"
  [7] "done"
  [8] "payload"
  [9] "local"
  [10] "local"
  [11] "local"
  [12] "local"
== types ==
  record KeepNumberInput tag=keep_number_input
    value: int
  record KeepTextInput tag=keep_text_input
    value: string
  record SiblingRegionLocalsInput tag=sibling_region_locals_input
    texts: list(string)
    numbers: list(int)
  union SiblingRegionLocalsOutcome
    done -> done_outcome(int)
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=sibling_region_locals_input_codec output=sibling_region_locals_outcome_codec
