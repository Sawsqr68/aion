  sig: (gated_item.Progress) -> Json
  v1 = field(v0, 1)
  v2 = field(v0, 2)
  v3 = json_obj {"item": v1|>awlc.string_to_json, "state": v2|>awlc.string_to_json}
  return v3
== fn progress_decoder/0 origin=codec_template(RecordTrio, Progress, record#2) ==
  sig: () -> Decoder(gated_item.Progress)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure progress_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#2, v0, v1)
== fn progress_decoder$0/1 origin=lifted(progress_decoder, #0) ==
  sig: (String) -> Decoder(gated_item.Progress)
  v1 = call_rt aion@awl@codec:string_decoder/0() live_after=[v0]
  v2 = make_closure progress_decoder$1 captures=[v0]
  tail_rt gleam@dynamic@decode:field/3(lit#3, v1, v2)
== fn progress_decoder$1/2 origin=lifted(progress_decoder, #1) ==
  sig: (String, String) -> Decoder(gated_item.Progress)
  v2 = record(progress, [v1, v0])
  tail_rt gleam@dynamic@decode:success/1(v2)
