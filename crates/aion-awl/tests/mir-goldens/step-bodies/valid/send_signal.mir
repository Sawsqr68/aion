  sig: () -> Codec(gated_item.GatedItemInput)
  v0 = make_closure gated_item_input_to_json captures=[]
  v1 = call_local gated_item_input_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
