module gated_item source=gated_item.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_announce:
    aion@signal:send/3 [signals] (v0, v2, nil)
    aion@signal:send/3 [signals] (v0, v7, v6)
  step_gate:
    aion@activity:task_queue/2 [activities] (v2, lit#15)
    aion@workflow:run/1 [activities] (v3)
    aion@workflow:receive/1 [signals] (v7)
    aion@signal:send/3 [signals] (v0, v12, v11)
    aion@signal:send/3 [signals] (v18, v20, v19)
== durable families == activities, signals
== atoms ==
  [0] decision
  [1] done
  [2] progress
  [3] verdict
  [4] evaluate_input
  [5] gated_item_input
  [6] done_outcome
  [7] ok
== literals ==
  [0] "approved"
  [1] "item"
  [2] "item"
  [3] "state"
  [4] "ok"
  [5] "item"
  [6] "coordinator_id"
  [7] "item_id"
  [8] "done"
  [9] "outcome"
  [10] ""
  [11] "GatedItemOutcome"
  [12] "done"
  [13] "payload"
  [14] "started"
  [15] "gates"
  [16] "gated: "
  [17] "gated"
== types ==
  record Decision tag=decision
    approved: bool
  record Done tag=done
    item: string
  record Progress tag=progress
    item: string
    state: string
  record Verdict tag=verdict
    ok: bool
  record EvaluateInput tag=evaluate_input
    item: string
  record GatedItemInput tag=gated_item_input
    coordinator_id: string
    item_id: string
  union GatedItemOutcome
    done -> done_outcome(ref(Done))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=gated_item_input_codec output=gated_item_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(gated_item.GatedItemInput, gated_item.GatedItemOutcome, AwlError)
  T-DEF name="gated_item" input=gated_item_input_codec output=gated_item_outcome_codec
== fn execute/1 origin=execute ==
  sig: (gated_item.GatedItemInput) -> Result(gated_item.GatedItemOutcome, AwlError)
  T-EXEC fields=[coordinator_id:String, item_id:String] entry=step_announce args=[0, 1]
== fn decision_codec/0 origin=codec_template(RecordTrio, Decision, record#0) ==
  sig: () -> Codec(gated_item.Decision)
  v0 = make_closure decision_to_json captures=[]
  v1 = call_local decision_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn decision_to_json/1 origin=codec_template(RecordTrio, Decision, record#0) ==
  sig: (gated_item.Decision) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"approved": v1|>awlc.bool_to_json}
  return v2
== fn decision_decoder/0 origin=codec_template(RecordTrio, Decision, record#0) ==
  sig: () -> Decoder(gated_item.Decision)
  v0 = call_rt aion@awl@codec:bool_decoder/0()
  v1 = make_closure decision_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn decision_decoder$0/1 origin=lifted(decision_decoder, #0) ==
  sig: (Bool) -> Decoder(gated_item.Decision)
  v1 = record(decision, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn done_codec/0 origin=codec_template(RecordTrio, Done, record#1) ==
  sig: () -> Codec(gated_item.Done)
  v0 = make_closure done_to_json captures=[]
  v1 = call_local done_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn done_to_json/1 origin=codec_template(RecordTrio, Done, record#1) ==
  sig: (gated_item.Done) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"item": v1|>awlc.string_to_json}
  return v2
== fn done_decoder/0 origin=codec_template(RecordTrio, Done, record#1) ==
  sig: () -> Decoder(gated_item.Done)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure done_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#1, v0, v1)
== fn done_decoder$0/1 origin=lifted(done_decoder, #0) ==
  sig: (String) -> Decoder(gated_item.Done)
  v1 = record(done, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
