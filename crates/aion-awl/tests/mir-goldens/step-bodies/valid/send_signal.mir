  sig: () -> Decoder(gated_item.Verdict)
  v0 = call_rt aion@awl@codec:bool_decoder/0()
  v1 = make_closure verdict_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#4, v0, v1)
== fn verdict_decoder$0/1 origin=lifted(verdict_decoder, #0) ==
  sig: (Bool) -> Decoder(gated_item.Verdict)
  v1 = record(verdict, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn evaluate_input_codec/0 origin=codec_template(RecordTrio, EvaluateInput, record#4) ==
  sig: () -> Codec(gated_item.EvaluateInput)
  v0 = make_closure evaluate_input_to_json captures=[]
  v1 = call_local evaluate_input_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn evaluate_input_to_json/1 origin=codec_template(RecordTrio, EvaluateInput, record#4) ==
  sig: (gated_item.EvaluateInput) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"item": v1|>awlc.string_to_json}
  return v2
== fn evaluate_input_decoder/0 origin=codec_template(RecordTrio, EvaluateInput, record#4) ==
  sig: () -> Decoder(gated_item.EvaluateInput)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure evaluate_input_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#5, v0, v1)
== fn evaluate_input_decoder$0/1 origin=lifted(evaluate_input_decoder, #0) ==
  sig: (String) -> Decoder(gated_item.EvaluateInput)
  v1 = record(evaluate_input, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
