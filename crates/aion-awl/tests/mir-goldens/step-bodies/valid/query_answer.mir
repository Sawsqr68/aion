  T-ACT action=evaluate input_codec=evaluate_input_codec return=decision_codec
== fn step_announce/2 origin=region(announce) ==
  sig: (String, Int) -> Result(gated_review.GatedReviewOutcome, AwlError)
  v2 = record(some, [lit#16])
  v3 = record(status, [lit#15, v2])
  v4 = make_closure awl_answer_reply_0 captures=[v3]
  v5 = call_local awl_answer_1(v4) live_after=[v0, v1]
  v6 = try_bind v5 live_after=[v0, v1]
  v7 = make_closure awl_answer_reply_2 captures=[v1]
  v8 = call_local awl_answer_3(v7) live_after=[v0, v1]
  v9 = try_bind v8 live_after=[v0, v1]
  v10 = make_closure awl_answer_reply_4 captures=[nil]
  v11 = call_local awl_answer_5(v10) live_after=[v0, v1]
  v12 = try_bind v11 live_after=[v0, v1]
  v13 = list([v0])
  v14 = make_closure awl_answer_reply_6 captures=[v13]
  v15 = call_local awl_answer_7(v14) live_after=[v0, v1]
  v16 = try_bind v15 live_after=[v0, v1]
  v17 = record(some, [v0])
  v18 = make_closure awl_answer_reply_8 captures=[v17]
  v19 = call_local awl_answer_9(v18) live_after=[v0, v1]
  v20 = try_bind v19 live_after=[v0, v1]
  tail_local step_gate(v0, v1)
== fn step_gate/2 origin=chain_step(announce.gate) ==
  sig: (String, Int) -> Result(gated_review.GatedReviewOutcome, AwlError)
  v2 = record(decision, ['false'])
  v3 = call_local gate_loop_0(v2, 0, v1, v0) live_after=[v0, v1]
  if is_tagged v3 ok/2:
    v4 = field(v3, 1)
    v5 = record(some, [v0])
    v6 = record(status, [lit#25, v5])
    v7 = make_closure awl_answer_reply_12 captures=[v6]
    v8 = call_local awl_answer_13(v7) live_after=[v0, v1, v4]
    if is_tagged v8 ok/2:
      v9 = field(v8, 1)
      v10 = field(v4, 1)
      if is_true v10:
        v11 = record(done, [v0])
        v12 = record(done_outcome, [v11])
        v13 = record(ok, [v12])
        return v13
      else:
        v14 = record(done, [v0])
        v15 = call_local done_to_json(v14)
        v16 = call_rt gleam@json:to_string/1(v15)
        v17 = record(awl_outcome_failure, [lit#27, v16])
        v18 = record(error, [v17])
        return v18
    else:
      tail_local gate_on_failure(v0, v1)
  else:
    tail_local gate_on_failure(v0, v1)
== fn gate_loop_0/4 origin=loop(gate#0) ==
  sig: (gated_review.Decision, Int, Int, String) -> Result(gated_review.Decision, AwlError)
  v4 = record(status, [lit#22, 'none'])
  v5 = make_closure awl_answer_reply_10 captures=[v4]
  v6 = call_local awl_answer_11(v5) live_after=[v1, v2, v3]
  v7 = try_bind v6 live_after=[v1, v2, v3]
  v8 = call_local evaluate_activity(v3) live_after=[v1, v2, v3]
  v9 = call_rt aion@activity:task_queue/2(v8, lit#24) live_after=[v1, v2, v3]
  v10 = call_rt aion@workflow:run/1(v9) live_after=[v1, v2, v3]
  v11 = call_rt aion@awl@error:map_activity_error/1(v10) live_after=[v1, v2, v3]
  v12 = try_bind v11 live_after=[v1, v2, v3]
  v13 = increment v1
  v15 = field(v12, 1)
  if is_true v15:
    v14 = record(ok, [v12])
    return v14
  else:
    if cmp Ge v13 v2:
      v14 = record(ok, [v12])
      return v14
    else:
      tail_local gate_loop_0(v12, v13, v2, v3)
== fn gate_on_failure/2 origin=compensation(gate) ==
  sig: (String, Int) -> Result(gated_review.GatedReviewOutcome, AwlError)
  v21 = record(some, [lit#29])
  v22 = record(status, [lit#28, v21])
  v23 = make_closure awl_answer_reply_14 captures=[v22]
  v24 = call_local awl_answer_15(v23) live_after=[v19]
  v25 = try_bind v24 live_after=[v19]
  v26 = record(done, [v19])
  v27 = call_local done_to_json(v26)
  v28 = call_rt gleam@json:to_string/1(v27)
  v29 = record(awl_outcome_failure, [lit#31, v28])
  v30 = record(error, [v29])
  return v30
