module gated_review source=gated_review.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  gate_loop_0:
    aion@activity:task_queue/2 [activities] (v8, lit#24)
    aion@workflow:run/1 [activities] (v9)
== durable families == activities
== atoms ==
  [0] decision
  [1] done
  [2] status
  [3] evaluate_input
  [4] gated_review_input
  [5] done_outcome
  [6] some
  [7] none
  [8] ok
  [9] awl_failed
  [10] error
  [11] false
  [12] awl_outcome_failure
== literals ==
  [0] "approved"
  [1] "item"
  [2] "phase"
  [3] "note"
  [4] "phase"
  [5] "note"
  [6] "item"
  [7] "item_id"
  [8] "max_passes"
  [9] "done"
  [10] "outcome"
  [11] ""
  [12] "GatedReviewOutcome"
  [13] "done"
  [14] "payload"
  [15] "announcing"
  [16] "no reviewer has looked yet"
  [17] "review_status"
  [18] "passes_left"
  [19] "heartbeat"
  [20] "notes"
  [21] "last_note"
  [22] "reviewing"
  [23] "review_status"
  [24] "gates"
  [25] "settled"
  [26] "review_status"
  [27] "gave_up"
  [28] "failed"
  [29] "the gate faulted"
  [30] "review_status"
  [31] "gave_up"
== types ==
  record Decision tag=decision
    approved: bool
  record Done tag=done
    item: string
  record Status tag=status
    phase: string
    note: nullable(string) optional
  record EvaluateInput tag=evaluate_input
    item: string
  record GatedReviewInput tag=gated_review_input
    item_id: string
    max_passes: int
  union GatedReviewOutcome
    done -> done_outcome(ref(Done))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=gated_review_input_codec output=gated_review_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(gated_review.GatedReviewInput, gated_review.GatedReviewOutcome, AwlError)
  T-DEF name="gated_review" input=gated_review_input_codec output=gated_review_outcome_codec
== fn execute/1 origin=execute ==
  sig: (gated_review.GatedReviewInput) -> Result(gated_review.GatedReviewOutcome, AwlError)
  T-EXEC fields=[item_id:String, max_passes:Int] entry=step_announce args=[0, 1]
