  v1 = make_closure greet_by_hand_outcome_decoder$outcome captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#11, v0, v1)
== fn greet_by_hand_outcome_decoder$outcome/1 origin=lifted(greet_by_hand_outcome_decoder, #0) ==
  sig: (String) -> Decoder(greet_by_hand.GreetByHandOutcome)
  if cmp Eq v0 lit#14:
    v3 = call_local greeting_decoder()
    v4 = make_closure greet_by_hand_outcome_decoder$arm0 captures=[]
    tail_rt gleam@dynamic@decode:field/3(lit#15, v3, v4)
  else:
    v1 = record(greeting, [lit#12])
    v2 = record(greeted_outcome, [v1])
    tail_rt gleam@dynamic@decode:failure/2(v2, lit#13)
== fn greet_by_hand_outcome_decoder$arm0/1 origin=lifted(greet_by_hand_outcome_decoder, #1) ==
  sig: (greet_by_hand.Greeting) -> Decoder(greet_by_hand.GreetByHandOutcome)
  v1 = record(greeted_outcome, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
== fn greet_activity/1 origin=activity_wrapper(greet, raw=false) ==
  sig: (String) -> Activity(greet_by_hand.GreetInput, greet_by_hand.RunOutcome)
  T-ACT action=greet input_codec=greet_input_codec return=run_outcome_codec
== fn polish_activity/1 origin=activity_wrapper(polish, raw=false) ==
  sig: (String) -> Activity(greet_by_hand.PolishInput, greet_by_hand.Greeting)
  T-ACT action=polish input_codec=polish_input_codec return=greeting_codec
== fn shout_activity/2 origin=activity_wrapper(shout, raw=false) ==
  sig: (String, String) -> Activity(greet_by_hand.ShoutInput, greet_by_hand.Stdout)
  T-ACT action=shout input_codec=shout_input_codec return=stdout_codec
== fn step_greet/1 origin=region(greet) ==
  sig: (String) -> Result(greet_by_hand.GreetByHandOutcome, AwlError)
  v1 = call_local greet_activity(v0) live_after=[v0]
  v2 = call_rt aion@activity:task_queue/2(v1, lit#16) live_after=[v0]
  v3 = call_rt aion@workflow:run/1(v2) live_after=[v0]
  v4 = call_rt aion@awl@error:map_activity_error/1(v3) live_after=[v0]
  v5 = try_bind v4 live_after=[v0]
  tail_local step_polish(v5, v0)
== fn step_polish/2 origin=chain_step(greet.polish) ==
  sig: (greet_by_hand.RunOutcome, String) -> Result(greet_by_hand.GreetByHandOutcome, AwlError)
  v2 = field(v0, 2)
  v3 = call_local polish_activity(v2) live_after=[v1]
  v4 = call_rt aion@activity:task_queue/2(v3, lit#17) live_after=[v1]
  v5 = call_rt aion@workflow:run/1(v4) live_after=[v1]
  v6 = call_rt aion@awl@error:map_activity_error/1(v5) live_after=[v1]
  v7 = try_bind v6 live_after=[v1]
  tail_local step_shout(v1, v7)
== fn step_shout/2 origin=chain_step(greet.shout) ==
  sig: (String, greet_by_hand.Greeting) -> Result(greet_by_hand.GreetByHandOutcome, AwlError)
  v2 = field(v1, 1)
  v3 = call_local shout_activity(v2, v0)
  v4 = call_rt aion@duration:milliseconds/1(30000) live_after=[v3]
  v5 = call_rt aion@activity:timeout/2(v3, v4)
  v6 = call_rt aion@activity:task_queue/2(v5, lit#18)
  v7 = call_rt aion@activity:node/2(v6, lit#19)
  v8 = call_rt aion@workflow:run/1(v7)
  v9 = call_rt aion@awl@error:map_activity_error/1(v8)
  v10 = try_bind v9
  v11 = field(v10, 1)
  v12 = record(greeting, [v11])
  v13 = record(greeted_outcome, [v12])
  v14 = record(ok, [v13])
  return v14
== fn awl$dead_body/1 origin=dead_body ==
  sig: (Dynamic) -> Result(Dynamic, AwlError)
  T-DEAD
