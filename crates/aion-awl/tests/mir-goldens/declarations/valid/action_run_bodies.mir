module greet_by_hand source=greet_by_hand.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_greet:
    aion@activity:task_queue/2 [activities] (v1, lit#16)
    aion@workflow:run/1 [activities] (v2)
  step_polish:
    aion@activity:task_queue/2 [activities] (v3, lit#17)
    aion@workflow:run/1 [activities] (v4)
  step_shout:
    aion@activity:timeout/2 [activities] (v3, v4)
    aion@activity:task_queue/2 [activities] (v5, lit#18)
    aion@activity:node/2 [activities] (v6, lit#19)
    aion@workflow:run/1 [activities] (v7)
== durable families == activities
== atoms ==
  [0] greeting
  [1] run_outcome
  [2] stdout
  [3] greet_input
  [4] polish_input
  [5] shout_input
  [6] greet_by_hand_input
  [7] greeted_outcome
  [8] ok
== literals ==
  [0] "text"
  [1] "exit_code"
  [2] "stdout"
  [3] "stderr"
  [4] "stdout"
  [5] "name"
  [6] "text"
  [7] "text"
  [8] "mark"
  [9] "name"
  [10] "greeted"
  [11] "outcome"
  [12] ""
  [13] "GreetByHandOutcome"
  [14] "greeted"
  [15] "payload"
  [16] "greeter"
  [17] "greeter"
  [18] "greeter"
  [19] "shell"
== types ==
  record Greeting tag=greeting
    text: string
  record RunOutcome tag=run_outcome
    exit_code: int
    stdout: string
    stderr: string
  record Stdout tag=stdout
    stdout: string
  record GreetInput tag=greet_input
    name: string
  record PolishInput tag=polish_input
    text: string
  record ShoutInput tag=shout_input
    text: string
    mark: string
  record GreetByHandInput tag=greet_by_hand_input
    name: string
  union GreetByHandOutcome
    greeted -> greeted_outcome(ref(Greeting))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=greet_by_hand_input_codec output=greet_by_hand_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(greet_by_hand.GreetByHandInput, greet_by_hand.GreetByHandOutcome, AwlError)
  T-DEF name="greet_by_hand" input=greet_by_hand_input_codec output=greet_by_hand_outcome_codec
== fn execute/1 origin=execute ==
  sig: (greet_by_hand.GreetByHandInput) -> Result(greet_by_hand.GreetByHandOutcome, AwlError)
  T-EXEC fields=[name:String] entry=step_greet args=[0]
