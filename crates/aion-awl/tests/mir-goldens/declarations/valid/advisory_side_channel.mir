module announce_and_build source=announce_and_build.awl
exports: run/1, definition/0, execute/1
== effect schedule ==
  step_announce:
    aion@activity:retry/2 [activities] (v1, v4)
    aion@activity:timeout/2 [activities] (v5, v6)
    aion@activity:task_queue/2 [activities] (v7, lit#10)
    aion@activity:node/2 [activities] (v8, lit#11)
    aion@workflow:run/1 [activities] (v9)
  step_build:
    aion@activity:timeout/2 [activities] (v1, v2)
    aion@activity:task_queue/2 [activities] (v3, lit#12)
    aion@activity:node/2 [activities] (v4, lit#13)
    aion@workflow:run/1 [activities] (v5)
== durable families == activities
== atoms ==
  [0] build_result
  [1] announce_input
  [2] compile_input
  [3] announce_and_build_input
  [4] built_outcome
  [5] fixed
  [6] retry_policy
  [7] ok
== literals ==
  [0] "artifact_path"
  [1] "project_dir"
  [2] "project_dir"
  [3] "project_dir"
  [4] "built"
  [5] "outcome"
  [6] ""
  [7] "AnnounceAndBuildOutcome"
  [8] "built"
  [9] "payload"
  [10] "builder"
  [11] "shell"
  [12] "builder"
  [13] "shell"
== types ==
  record BuildResult tag=build_result
    artifact_path: string
  record AnnounceInput tag=announce_input
    project_dir: string
  record CompileInput tag=compile_input
    project_dir: string
  record AnnounceAndBuildInput tag=announce_and_build_input
    project_dir: string
  union AnnounceAndBuildOutcome
    built -> built_outcome(ref(BuildResult))
== fn run/1 origin=run ==
  sig: (Dynamic) -> Result(String, AwlError)
  T-RUN input=announce_and_build_input_codec output=announce_and_build_outcome_codec
== fn definition/0 origin=definition ==
  sig: () -> WorkflowDefinition(announce_and_build.AnnounceAndBuildInput, announce_and_build.AnnounceAndBuildOutcome, AwlError)
  T-DEF name="announce_and_build" input=announce_and_build_input_codec output=announce_and_build_outcome_codec
== fn execute/1 origin=execute ==
  sig: (announce_and_build.AnnounceAndBuildInput) -> Result(announce_and_build.AnnounceAndBuildOutcome, AwlError)
  T-EXEC fields=[project_dir:String] entry=step_announce args=[0]
== fn build_result_codec/0 origin=codec_template(RecordTrio, BuildResult, record#0) ==
  sig: () -> Codec(announce_and_build.BuildResult)
  v0 = make_closure build_result_to_json captures=[]
  v1 = call_local build_result_decoder() live_after=[v0]
  tail_rt aion@codec:json_codec/2(v0, v1)
== fn build_result_to_json/1 origin=codec_template(RecordTrio, BuildResult, record#0) ==
  sig: (announce_and_build.BuildResult) -> Json
  v1 = field(v0, 1)
  v2 = json_obj {"artifact_path": v1|>awlc.string_to_json}
  return v2
== fn build_result_decoder/0 origin=codec_template(RecordTrio, BuildResult, record#0) ==
  sig: () -> Decoder(announce_and_build.BuildResult)
  v0 = call_rt aion@awl@codec:string_decoder/0()
  v1 = make_closure build_result_decoder$0 captures=[]
  tail_rt gleam@dynamic@decode:field/3(lit#0, v0, v1)
== fn build_result_decoder$0/1 origin=lifted(build_result_decoder, #0) ==
  sig: (String) -> Decoder(announce_and_build.BuildResult)
  v1 = record(build_result, [v0])
  tail_rt gleam@dynamic@decode:success/1(v1)
