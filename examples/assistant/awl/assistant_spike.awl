//! SPIKE — proves one thing and nothing else: that an AWL document can drive
//! the agent-dev worker's `assistant` agent action end to end on a real
//! server. Provision a session workspace, run ONE agent round, return the
//! reply. No loop, no operator signal, no round budget — those belong to the
//! real port, and building them before this seam is proven would be building
//! on an assumption.
//!
//! It exists because the Gleam-authored `assistant` package cannot start at
//! all under queue-routed serving (docs/design/aion-authoring/
//! GLEAM-PATH-CANNOT-START-FINDING.md): a project manifest has no field for a
//! task queue, so every activity is committed unscoped and start is refused.
//! AWL declares its worker queue, so it is the only surface that can.
//!
//! The action shapes below are NOT invented — they mirror what the agent-dev
//! worker advertises (`examples/assistant/src/assistant_io.gleam`:
//! `ProvisionInput(repo_path, run_id)` -> `Workspace(path)`, and the agent
//! round as one prompt string in, one terminal-text string out). A shape that
//! disagrees is refused at worker registration with WORKER_CONTRACT_MISMATCH.
workflow assistant_spike
  timeout 1h
  input objective: String
  input repo_path: String
  outcome answered: type Answered, route success

/// The provisioned session workspace, materialised at `<root>/<run_id>/repo`.
type Workspace { path: String }

/// What one proven round returns: the agent's reply and where it worked.
type Answered { reply: String, workspace_path: String }

worker default
  /// Materialises the session workspace. `run_id` must be the workflow's own
  /// run id: it keys the worker-side directory AND must equal the id the
  /// agent-harness `--workspace-root` template expands to, or the agent works
  /// somewhere other than where it was provisioned.
  action assistant_provision(repo_path: String, run_id: String) -> Workspace

  /// One agent round under the norn-harness contract: ONE prompt string in,
  /// ONE terminal-text string out. The worker pins one norn session per
  /// activity type per run, so repeated dispatches resume one conversation.
  action assistant(prompt: String) -> String

step provision
  assistant_provision(repo_path: repo_path, run_id: workflow.id) -> session

step round after provision
  assistant(prompt: objective) -> reply
  route answered(reply: reply, workspace_path: session.path)
