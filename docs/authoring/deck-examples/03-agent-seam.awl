//! An agent seam: a String prompt in, the agent-outcome record out.
workflow agent_demo
  input question: String
  outcome done: type String, route success

/// The canonical agent-outcome record, declared under this document's own name: accumulated
/// `text`, the last answer as `final_message`, the canonical `stop_reason`, and the `session_id`
/// handle of the conversation that produced it.
type Reply { text: String, final_message: String, stop_reason: String, session_id: String }

worker assistants
  /// `agent` says: this parameter is a PROMPT and this result is the agent's
  /// outcome record — its reply `text` plus why the run stopped.
  action ask(prompt: String) -> Reply
    agent, timeout 10m

step think
  ask(prompt: question) -> reply
  reply.text |> route done
