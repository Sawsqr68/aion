{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist/cjs",
    "declaration": false,
    "declarationMap": false,
    "declarationDir": null,
    "verbatimModuleSyntax": false
  },
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts"
  ]
}
