//! gate_ops — the measurement half of the gate workflow, WHOLE CLOTH: every
//! command is written out in full inside this document and sealed into the
//! package's content hash at deploy. No script files on any box, no path a
//! command resolves at run time, nothing on the operator's machine — the
//! review of this file is the review of exactly what will run (Tom's order,
//! 2026-08-18: "the commands need to be written up, whole cloth").
//!
//! Served with `aion worker awl` on a fleet box; the commands run on THAT
//! host. Each body is `sh -c '<the whole script>' -- <params>`: the script
//! text is literal to AWL (single-quote region), parameters arrive as sh
//! positionals, and a parameter value can never become code.
//!
//! EXIT ZERO ALWAYS, REFUSAL AS DATA: every anticipated face — red suite,
//! missing tree, unreadable log — returns exit-zero as a typed probe with
//! the rc or refusal named, because a nonzero exit is a retryable-then-
//! terminal activity failure and the workflow must ROUTE on these faces.
//!
//! CONTENTION CLASSIFIED AT THE SOURCE: each leg greps its OWN log for the
//! contention signatures measured on this estate (EMFILE "Too many open
//! files"; lld deaths as "LLVM ERROR", "signal: 11", "SIGSEGV") and reports
//! `contended` beside the rc — the workflow's rerun policy consumes the
//! classification, it never invents one.
//!
//! ENVIRONMENT DECLARED, NOT INHERITED: the workflow gate context can carry
//! an EMPTY HOME (measured 2026-08-18, fleet-53 reds); every body sets PATH
//! absolutely, defaults HOME, and raises the fd soft limit inline.
worker gate_ops
  /// Identify the tree: it must exist and be a git work tree; its HEAD pins
  /// every verdict to the exact tree measured.
  action probe_tree(tree: String) -> TreeProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then HOME=/home/aion; export HOME; fi; t=\"$1\"; if [ ! -d \"$t\" ]; then printf \"{\\\"ok\\\":false,\\\"refusal\\\":\\\"tree directory does not exist\\\",\\\"head_commit\\\":\\\"\\\"}\"; exit 0; fi; h=$(git -C \"$t\" rev-parse HEAD 2>/dev/null); if [ -z \"$h\" ]; then printf \"{\\\"ok\\\":false,\\\"refusal\\\":\\\"not a git work tree or HEAD unreadable\\\",\\\"head_commit\\\":\\\"\\\"}\"; exit 0; fi; printf \"{\\\"ok\\\":true,\\\"refusal\\\":\\\"\\\",\\\"head_commit\\\":\\\"%s\\\"}\" \"$h\"' -- $tree"
  /// Full workspace test suite at bounded parallelism; log to the tree.
  action run_test_workspace(tree: String, kind: String, jobs: Int) -> LegProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then HOME=/home/aion; export HOME; fi; ulimit -n 65536 2>/dev/null || true; t=\"$1\"; k=\"$2\"; j=\"$3\"; mkdir -p \"$t/.gate\" 2>/dev/null; l=\"$t/.gate/$k.log\"; ( cd \"$t\" && cargo test --workspace -j \"$j\" ) > \"$l\" 2>&1; rc=$?; g=false; [ \"$rc\" = \"0\" ] && g=true; c=false; grep -qE \"Too many open files|LLVM ERROR|signal: 11|SIGSEGV\" \"$l\" 2>/dev/null && c=true; printf \"{\\\"kind\\\":\\\"%s\\\",\\\"green\\\":%s,\\\"rc\\\":%d,\\\"contended\\\":%s,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"\\\"}\" \"$k\" \"$g\" \"$rc\" \"$c\" \"$l\"' -- $tree $kind $jobs"
  /// Workspace clippy wall, all targets, warnings denied.
  action run_clippy_workspace(tree: String, kind: String, jobs: Int) -> LegProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then HOME=/home/aion; export HOME; fi; ulimit -n 65536 2>/dev/null || true; t=\"$1\"; k=\"$2\"; j=\"$3\"; mkdir -p \"$t/.gate\" 2>/dev/null; l=\"$t/.gate/$k.log\"; ( cd \"$t\" && cargo clippy --workspace --all-targets -j \"$j\" -- -D warnings ) > \"$l\" 2>&1; rc=$?; g=false; [ \"$rc\" = \"0\" ] && g=true; c=false; grep -qE \"Too many open files|LLVM ERROR|signal: 11|SIGSEGV\" \"$l\" 2>/dev/null && c=true; printf \"{\\\"kind\\\":\\\"%s\\\",\\\"green\\\":%s,\\\"rc\\\":%d,\\\"contended\\\":%s,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"\\\"}\" \"$k\" \"$g\" \"$rc\" \"$c\" \"$l\"' -- $tree $kind $jobs"
  /// One crate's clippy wall — the feature-resolution twin the caller states
  /// beside the workspace run.
  action run_clippy_crate(tree: String, kind: String, crate_name: String) -> LegProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then HOME=/home/aion; export HOME; fi; ulimit -n 65536 2>/dev/null || true; t=\"$1\"; k=\"$2\"; n=\"$3\"; mkdir -p \"$t/.gate\" 2>/dev/null; l=\"$t/.gate/$k-$n.log\"; ( cd \"$t\" && cargo clippy -p \"$n\" --all-targets -- -D warnings ) > \"$l\" 2>&1; rc=$?; g=false; [ \"$rc\" = \"0\" ] && g=true; c=false; grep -qE \"Too many open files|LLVM ERROR|signal: 11|SIGSEGV\" \"$l\" 2>/dev/null && c=true; printf \"{\\\"kind\\\":\\\"%s\\\",\\\"green\\\":%s,\\\"rc\\\":%d,\\\"contended\\\":%s,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"\\\"}\" \"$k\" \"$g\" \"$rc\" \"$c\" \"$l\"' -- $tree $kind $crate_name"
  /// One crate's lib unit population.
  action run_test_crate_lib(tree: String, kind: String, crate_name: String) -> LegProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then HOME=/home/aion; export HOME; fi; ulimit -n 65536 2>/dev/null || true; t=\"$1\"; k=\"$2\"; n=\"$3\"; mkdir -p \"$t/.gate\" 2>/dev/null; l=\"$t/.gate/$k-$n.log\"; ( cd \"$t\" && cargo test -p \"$n\" --lib ) > \"$l\" 2>&1; rc=$?; g=false; [ \"$rc\" = \"0\" ] && g=true; c=false; grep -qE \"Too many open files|LLVM ERROR|signal: 11|SIGSEGV\" \"$l\" 2>/dev/null && c=true; printf \"{\\\"kind\\\":\\\"%s\\\",\\\"green\\\":%s,\\\"rc\\\":%d,\\\"contended\\\":%s,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"\\\"}\" \"$k\" \"$g\" \"$rc\" \"$c\" \"$l\"' -- $tree $kind $crate_name"
  /// Formatting check — measurement only; the autoformat law lives upstream.
  action run_fmt_check(tree: String, kind: String) -> LegProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then HOME=/home/aion; export HOME; fi; t=\"$1\"; k=\"$2\"; mkdir -p \"$t/.gate\" 2>/dev/null; l=\"$t/.gate/$k.log\"; ( cd \"$t\" && cargo fmt --check ) > \"$l\" 2>&1; rc=$?; g=false; [ \"$rc\" = \"0\" ] && g=true; printf \"{\\\"kind\\\":\\\"%s\\\",\\\"green\\\":%s,\\\"rc\\\":%d,\\\"contended\\\":false,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"\\\"}\" \"$k\" \"$g\" \"$rc\" \"$l\"' -- $tree $kind"
  /// The lock witness: rows for `crate_name` in the RESOLVED lock whose
  /// version matches the refused `pattern` red the leg — a floor is proven
  /// at the lock, never at a manifest line.
  action run_lock_witness(tree: String, kind: String, crate_name: String, pattern: String) -> LegProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then HOME=/home/aion; export HOME; fi; t=\"$1\"; k=\"$2\"; n=\"$3\"; p=\"$4\"; mkdir -p \"$t/.gate\" 2>/dev/null; l=\"$t/.gate/$k-$n.log\"; if [ ! -f \"$t/Cargo.lock\" ]; then printf \"{\\\"kind\\\":\\\"%s\\\",\\\"green\\\":false,\\\"rc\\\":90,\\\"contended\\\":false,\\\"log_path\\\":\\\"\\\",\\\"refusal\\\":\\\"Cargo.lock absent — a floor cannot be witnessed without the resolved graph\\\"}\" \"$k\"; exit 0; fi; bad=$(grep -A1 \"^name = \\\"$n\\\"\" \"$t/Cargo.lock\" | grep \"^version\" | grep -E \"$p\"); if [ -n \"$bad\" ]; then printf \"%s\\n\" \"$bad\" > \"$l\"; printf \"{\\\"kind\\\":\\\"%s\\\",\\\"green\\\":false,\\\"rc\\\":1,\\\"contended\\\":false,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"\\\"}\" \"$k\" \"$l\"; else printf \"witness clean\" > \"$l\"; printf \"{\\\"kind\\\":\\\"%s\\\",\\\"green\\\":true,\\\"rc\\\":0,\\\"contended\\\":false,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"\\\"}\" \"$k\" \"$l\"; fi' -- $tree $kind $crate_name $pattern"
  /// Refuse a leg kind outside the closed vocabulary — a NAMED red probe in
  /// the results (never a skip), naming the accepted vocabulary as the remedy.
  action refuse_leg(kind: String) -> LegProbe
    run json "sh -c 'set -u; k=\"$1\"; printf \"{\\\"kind\\\":\\\"%s\\\",\\\"green\\\":false,\\\"rc\\\":91,\\\"contended\\\":false,\\\"log_path\\\":\\\"\\\",\\\"refusal\\\":\\\"unknown leg kind — gate serves exactly: test_workspace, clippy_workspace, clippy_crate, test_crate_lib, fmt_check, lock_witness\\\"}\" \"$k\"' -- $kind"

type TreeProbe { ok: Bool, refusal: String, head_commit: String }

type LegProbe {
  kind: String,
  green: Bool,
  rc: Int,
  contended: Bool,
  log_path: String,
  refusal: String,
}
