//! fleet_chain_ops — the mechanical half of the staged-flight chain,
//! served with `aion worker awl` on the fleet box: the commands run where
//! the tree lives. Every command is `sh /home/aion/fleet/bin/<script>.sh
//! $params`; the scripts' source of truth is this folder's `bin/`,
//! provisioning copies them, and the runbook records their sha256.
//!
//! EXIT ZERO ALWAYS, INNER CODE AS DATA: under `run json` a nonzero exit is
//! an activity failure and its stdout is DISCARDED — so every anticipated
//! face here exits zero, the inner command's status rides back as typed
//! data, and the workflow routes on the typed field. This is the same law
//! `fleet_ops_worker.awl` states and for the same reason: a refused
//! conclusion is a routed finding carrying its evidence, never a
//! retried-then-terminal failure that threw the evidence away.
//!
//! THIS IS A NEW DOCUMENT. The conclusion verifier is deliberately NOT
//! added to `fleet_ops_worker.awl`: that document is byte-frozen by the
//! design's compatibility proof (§7 clause 2), and Resolution C — widening
//! the legacy parallel contract with data only the chain uses — is refused
//! by name in the design's own refusal table (§10).
//!
//! THE COORDINATOR NEVER RE-READS THE WORLD. Every action here takes the
//! recorded `ChainState` and returns a new one. The verifier reads the
//! conclusion token BY EXACT OBJECT ID and refuses a ref name before any
//! git process starts; nothing here resolves a branch, reads a worktree,
//! greps prose, or consults a clock (§6, verbatim prohibition).
worker fleet_chain_ops
  /// Validate the committed `fleet-stages-v1` block and return the
  /// NORMALIZED TYPED GRAPH — the run's ordering authority for the whole
  /// chain (§5.3 final ¶). Inner code 0 is a valid chain OR a plan with no
  /// block at all; 1 is absent/incomplete committed plan state; 3 is the
  /// pre-existing dispatch-vs-plan naming mismatch; 4 is PLAN GRAPH
  /// INVALID carrying a stable cause code. Code 2 remains the shared
  /// script guard face.
  action chain_plan_check(workspace_root: String, run_name: String, leg_ids_csv: String, max_stages: Int) -> ChainPlan
    run json "sh /home/aion/fleet/bin/fleet-chain-plan-check.sh $workspace_root $run_name $leg_ids_csv $max_stages"
  /// Start ONE ordinary `fleet_dev` stage flight from the exact base the
  /// recorded state names, and return its dispatch receipt IMMEDIATELY —
  /// the child workflow id, recorded before the child is awaited (§6
  /// clause 2). This action does not wait for the flight: a stage is hours
  /// long and a blocking activity sized to that is neither observable nor
  /// replayable.
  action chain_dispatch(state: ChainState) -> ChainState
    run json "sh /home/aion/fleet/bin/fleet-chain-dispatch.sh $state"
  /// Await the recorded child's terminal outcome and exact receipts.
  /// POLL + TOTAL DEADLINE + TIMEOUT AS A DISTINCT OUTCOME — never one
  /// blocking sleep sized to the expected duration. Returns the child's
  /// TYPED outcome label as data, which is what lets `stage_failed.cause`
  /// preserve it: an AWL `on failure` edge binds no label (measured on
  /// this tree, movement finding M4).
  action chain_await(state: ChainState) -> ChainState
    run json "sh /home/aion/fleet/bin/fleet-chain-await.sh $state"
  /// THE SEALED VERIFIER (§2.6, §6 clause 4). Reads
  /// `.fleet/conclusions/<stage-id>` from the child's EXACT RECORDED
  /// pushed commit — never a branch, never a worktree, never a
  /// `git rev-parse` of a name. The token is exactly one declared value,
  /// one LF, and no other bytes. An absent or invalid artifact is NOT
  /// `unplanned` and NOT silently a stage failure: it returns
  /// `stage_conclusion_refused` with cause code exactly one of
  /// `conclusion_missing`, `conclusion_malformed`, `conclusion_undeclared`,
  /// carrying `observed_bytes`.
  action chain_verify(state: ChainState) -> ChainState
    run json "sh /home/aion/fleet/bin/fleet-chain-verify.sh $state"
  /// Apply `advance`: record the exact ACCEPTED result SHA, or record the
  /// hold decision. Reachable only after the conclusion has verified — no
  /// hold can approve a stage whose conclusion has not verified (§2.6).
  action chain_accept(state: ChainState) -> ChainState
    run json "sh /home/aion/fleet/bin/fleet-chain-accept.sh $state"
  /// Evaluate the successor's admission from RECORDED history alone, and
  /// record `run` or `skipped` BEFORE proceeding (§6 clause 6). A skip
  /// names the stage, the source stage, the observed conclusion, and the
  /// canonical condition; no worktree is cut and no builder seat is spent.
  action chain_admit(state: ChainState) -> ChainState
    run json "sh /home/aion/fleet/bin/fleet-chain-admit.sh $state"

/// The chain's whole recorded state, threaded through every boundary.
/// `ledger` is the serialized append-only record of every decision — the
/// durable home design §6 requires, and the explicit payload a
/// `ContinuedAsNew` carries forward rather than rediscovering from git.
type ChainState {
  halted: Bool,
  verdict: String,
  stage_id: String,
  child_workflow_id: String,
  base_commit: String,
  result_commit: String,
  accepted_commit: String,
  conclusion: String,
  cause: String,
  cause_code: String,
  observed_bytes: String,
  kept_root: String,
  last_accepted_commit: String,
  ledger: String,
}

/// A `check_plan` reply: the inner exit code as data, the normalized typed
/// graph on success, and the stable cause code on an exit-4 refusal.
type ChainPlan {
  exit_code: Int,
  chain_block: Bool,
  graph: String,
  cause_code: String,
  stage_id: String,
  stdout: String,
  stderr: String,
}
