//! fleet_ops — the mechanical half of the fleet-dev loop, served with
//! `aion worker awl` on the fleet box: the commands run where the tree
//! lives. Every command is `sh /home/aion/fleet/bin/<script>.sh $params`;
//! the scripts' source of truth is this folder's `bin/`, provisioning
//! copies them, and the runbook records their sha256.
//!
//! EXIT ZERO ALWAYS, INNER CODE AS DATA: under `run json` a nonzero exit is
//! an activity failure and its stdout is DISCARDED — so every anticipated
//! face here exits zero, `OpProbe.exit_code` is the INNER command's status,
//! and the workflow routes on the typed field. A red gate is a routed
//! finding carrying its evidence, never a retried-then-terminal failure
//! that threw the findings away.
worker fleet_ops
  /// Clone at the named ref under the confined run root; refuse (as data)
  /// a leftover root, and set a repo-local git identity so merges and the
  /// gate script's findings commits are attributable to the fleet.
  action clone(repo_url: String, base_ref: String, workspace_root: String, run_name: String) -> CloneProbe
    run json "sh /home/aion/fleet/bin/fleet-clone.sh $repo_url $base_ref $workspace_root $run_name"
  /// Check the plan and dispatch-fixed leg ids at committed HEAD: inner code
  /// 0 is complete; 1 is an absent/incomplete plan (including loose `.fleet`
  /// state); 3 is a dispatch-vs-plan naming mismatch where committed briefs
  /// exist but declared names are missing. Code 2 remains the shared script
  /// guard face. A mismatch is not an absent plan: its stdout carries
  /// DECLARED versus FOUND ids for the refusal payload.
  action plan_check(workspace_root: String, run_name: String, leg_ids_csv: String) -> OpProbe
    run json "sh /home/aion/fleet/bin/fleet-plan-check.sh $workspace_root $run_name $leg_ids_csv"
  /// One isolated worktree and one branch per leg, cut from the planned
  /// tree at `<root>/legs/<id>`. Refuses loudly rather than deleting
  /// anything in its way.
  action fanout(workspace_root: String, run_name: String, leg_ids_csv: String) -> OpProbe
    run json "sh /home/aion/fleet/bin/fleet-fanout.sh $workspace_root $run_name $leg_ids_csv"
  /// Ordered no-ff merges of the leg branches into the primary tree; records
  /// the merged leg branch refs in `.fleet/legs-merged.md`. A conflict aborts
  /// clean and names the files — a finding about the plan's leg boundaries,
  /// never an agent's to resolve in passing.
  action fanin(workspace_root: String, run_name: String, leg_ids_csv: String) -> OpProbe
    run json "sh /home/aion/fleet/bin/fleet-fanin.sh $workspace_root $run_name $leg_ids_csv"
  /// Every promised `.fleet/reports/<id>.md` committed in the merged tree,
  /// missing legs named on stdout.
  action report_check(workspace_root: String, run_name: String, leg_ids_csv: String) -> OpProbe
    run json "sh /home/aion/fleet/bin/fleet-report-check.sh $workspace_root $run_name $leg_ids_csv"
  /// Run the repo's own gate entry; on red, COMMIT the findings whole, and
  /// on green COMMIT the routed tail, to `.fleet/gates/` (numbered history
  /// plus the stable red `RED-LATEST.md` address)
  /// so the fix round reads the verbatim evidence from the tree.
  action gates(workspace_root: String, run_name: String, gate_entry: String) -> OpProbe
    run json "sh /home/aion/fleet/bin/fleet-gates.sh $workspace_root $run_name $gate_entry"
  /// Push the merged branch home with a receipt; refusals are typed and
  /// never forced.
  action push(workspace_root: String, run_name: String, result_branch: String) -> PushProbe
    run json "sh /home/aion/fleet/bin/fleet-push.sh $workspace_root $run_name $result_branch"
  /// Remove the run's tree — root pinned exactly, id shaped, the check
  /// gating the rm in the same script.
  action teardown(workspace_root: String, run_name: String) -> TeardownProbe
    run json "sh /home/aion/fleet/bin/fleet-teardown.sh $workspace_root $run_name"
  /// Copy the four primary-tree agent sessions' transcripts into
  /// `.fleet/sessions/` and COMMIT them; an unreachable source is a
  /// committed typed absence, never a silent skip.
  action sessions(workspace_root: String, run_name: String, counsel_control_session: String, dev_control_session: String, plan_session: String, judge_session: String) -> OpProbe
    run json "sh /home/aion/fleet/bin/fleet-sessions.sh primary $workspace_root $run_name $counsel_control_session $dev_control_session $plan_session $judge_session"
  /// One named session's transcript, copied and committed into the tree it
  /// ran in — a leg worktree (riding home through fanin) or the primary.
  action session(workspace_root: String, run_name: String, tree: String, step_label: String, session_id: String) -> OpProbe
    run json "sh /home/aion/fleet/bin/fleet-sessions.sh one $workspace_root $run_name $tree $step_label $session_id"

type CloneProbe { ok: Bool, refusal: String, root: String, repo_path: String, head_commit: String }

type OpProbe { exit_code: Int, stdout: String, stderr: String }

type PushProbe { ok: Bool, refusal: String, branch: String, pushed_commit: String, remote: String }

type TeardownProbe { ok: Bool, removed: String, refusal: String }
