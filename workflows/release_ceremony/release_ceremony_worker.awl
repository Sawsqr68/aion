//! release_ops — the hands of release_ceremony, WHOLE CLOTH: every command
//! written out in full and sealed into the package's content hash at deploy
//! (Tom's order: no local scripts; the review of this file is the review of
//! exactly what will run). Served with `aion worker awl`; commands run on
//! the worker's host with a CLEARED ENVIRONMENT — every body sets PATH
//! absolutely, derives HOME from the filesystem, and the PATH names both
//! estate hosts' toolchains (box /home/aion, Mac /Users/tom).
//!
//! EXIT ZERO ALWAYS, REFUSAL AS DATA: every anticipated face — a dirty
//! tree, an undated changelog, a missing tool, a red publish, an index that
//! does not confirm — returns exit-zero as a typed probe with the rc or
//! refusal named, because the workflow must ROUTE on these faces.
//!
//! IDEMPOTENT PUBLISH: publish_and_confirm skips a crate already at the
//! index (recorded `skipped: true`) and still confirms it with its
//! checksum, so a partial ceremony re-runs to completion with the same
//! input. cargo itself refuses a publish whose dependency is not at the
//! index yet — a wrong declared order is a loud red, never a reorder.
//!
//! Logs live in the tree at `<tree>/.release/` — the tree is the
//! blackboard; `.release/` never rides a commit.
//!
//! REPO-AGNOSTIC AS OF 2026-08-20: the changelog leg's embed-sync face no
//! longer names an aion path. Each repo DECLARES its own pairs in
//! `<tree>/release-ceremony.json` — `{repo, changelog_embeds:[{source,
//! embed}]}` — the same repo-owned-truth pattern as gates.json. The
//! declaration is deliberately NOT a ceremony input: an input is fakeable by
//! its caller, and an aion release could silently omit its own embed check by
//! leaving the argument off. A repo-owned file travels with the tree, is
//! version-controlled, and its removal shows up in a diff.
//!
//! ABSENCE REFUSES; IT NEVER PASSES. A missing declaration or a missing
//! changelog_embeds key is a refusal (`embed_status: undeclared`), the same
//! discipline as run_semver_check returning rc 90 when the tool is absent. A
//! repo that embeds no changelog must SAY SO with an empty array — that is
//! declared absence, and it writes a loud `.release/changelog-embed-status.txt`
//! and a loud embed_status rather than wearing a green tick it did not earn.
//! `embed_status` rides the recorded activity result, so the ceremony's own
//! durable history carries which of those two worlds it was in.
worker release_ops
  /// The cut witness: the tree exists, is a clean git work tree (untracked
  /// blackboards ignored), and its workspace version IS the declared one —
  /// read anchored inside the [workspace.package] section, so a version
  /// line in some dependency table can never be the one measured.
  action probe_release_tree(tree: String, version: String) -> TreeProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/Users/tom/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then if [ -d /home/aion ]; then HOME=/home/aion; else HOME=/Users/tom; fi; export HOME; fi; t=\"$1\"; v=\"$2\"; if [ ! -d \"$t\" ]; then printf \"{\\\"ok\\\":false,\\\"refusal\\\":\\\"tree directory does not exist\\\",\\\"head_commit\\\":\\\"\\\",\\\"workspace_version\\\":\\\"\\\"}\"; exit 0; fi; h=$(git -C \"$t\" rev-parse HEAD 2>/dev/null); if [ -z \"$h\" ]; then printf \"{\\\"ok\\\":false,\\\"refusal\\\":\\\"not a git work tree or HEAD unreadable\\\",\\\"head_commit\\\":\\\"\\\",\\\"workspace_version\\\":\\\"\\\"}\"; exit 0; fi; dirty=$(git -C \"$t\" status --porcelain | grep -cv \"^??\"); if [ \"$dirty\" -gt 0 ]; then printf \"{\\\"ok\\\":false,\\\"refusal\\\":\\\"tree has tracked modifications — a ceremony publishes exactly what landed\\\",\\\"head_commit\\\":\\\"%s\\\",\\\"workspace_version\\\":\\\"\\\"}\" \"$h\"; exit 0; fi; wv=$(sed -n \"/^\\\\[workspace.package\\\\]/,/^\\\\[/p\" \"$t/Cargo.toml\" | grep -m1 \"^version = \" | sed -n \"s/^version = .\\\\([0-9][^\\\"]*\\\\).*/\\\\1/p\"); if [ \"$wv\" != \"$v\" ]; then printf \"{\\\"ok\\\":false,\\\"refusal\\\":\\\"workspace version %s does not wear the declared release version %s\\\",\\\"head_commit\\\":\\\"%s\\\",\\\"workspace_version\\\":\\\"%s\\\"}\" \"$wv\" \"$v\" \"$h\" \"$wv\"; exit 0; fi; printf \"{\\\"ok\\\":true,\\\"refusal\\\":\\\"\\\",\\\"head_commit\\\":\\\"%s\\\",\\\"workspace_version\\\":\\\"%s\\\"}\" \"$h\" \"$wv\"' -- $tree $version"
  /// Dated section at the root; every embed pair the REPO declares in
  /// release-ceremony.json byte-identical to its source; and the
  /// commits-since evidence written to the blackboard for the review.
  /// Needs jq on the worker host — its absence refuses, never skips.
  action check_changelog(tree: String, version: String, prev_tag: String) -> ChangelogProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/Users/tom/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then if [ -d /home/aion ]; then HOME=/home/aion; else HOME=/Users/tom; fi; export HOME; fi; t=\"$1\"; v=\"$2\"; p=\"$3\"; em() { printf \"{\\\"dated\\\":%s,\\\"embed_synced\\\":%s,\\\"embed_status\\\":\\\"%s\\\",\\\"commit_count\\\":%s,\\\"commits_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"%s\\\"}\" \"$1\" \"$2\" \"$3\" \"$4\" \"$5\" \"$6\"; exit 0; }; if [ ! -d \"$t\" ]; then em false false unmeasured 0 \"\" \"tree does not exist or is not a directory: $t\"; fi; mkdir -p \"$t/.release\" 2>/dev/null || em false false unmeasured 0 \"\" \"could not create the release blackboard at $t/.release\"; cp=\"$t/.release/commits-since-$p.log\"; git -C \"$t\" log --format=%s \"$p\"..HEAD > \"$cp\" 2>/dev/null || em false false unmeasured 0 \"$cp\" \"git log $p..HEAD failed in $t — is $p a tag in this repo\"; n=$(grep -c . \"$cp\" 2>/dev/null); n=${n:-0}; case \"$n\" in \"\"|*[!0-9]*) n=0 ;; esac; d=false; grep -q \"^## $v — 20\" \"$t/CHANGELOG.md\" 2>/dev/null && d=true; if [ \"$d\" = \"false\" ]; then em false false not-reached \"$n\" \"$cp\" \"CHANGELOG.md has no dated section for $v — expected a header of the form: ## $v — YYYY-MM-DD (em dash, ISO date); the changelog refuses before the first publish\"; fi; dc=\"$t/release-ceremony.json\"; [ -f \"$dc\" ] || em true false undeclared \"$n\" \"$cp\" \"no release declaration at release-ceremony.json in $t — the ceremony will not guess whether this repo embeds its changelog; declare it, repo-owned truth like gates.json, shape {repo, changelog_embeds:[{source,embed}]}. A repo with no embedded changelog declares changelog_embeds as an empty array — that is declared absence and prints a loud not-applicable line. An absent declaration refuses; it never passes\"; command -v jq >/dev/null 2>&1 || em true false unmeasured \"$n\" \"$cp\" \"jq is not on PATH, so release-ceremony.json cannot be read — install jq. The gate refuses rather than skipping a check it could not perform\"; jq -e . \"$dc\" >/dev/null 2>&1 || em true false unmeasured \"$n\" \"$cp\" \"release-ceremony.json is not valid JSON: $dc\"; jq -e \"has(\\\"changelog_embeds\\\")\" \"$dc\" >/dev/null 2>&1 || em true false undeclared \"$n\" \"$cp\" \"release-ceremony.json has no changelog_embeds key — declare it explicitly, as an empty array if this repo embeds no changelog. The key is required so that absence is a decision somebody committed, not an omission\"; jq -e \".changelog_embeds | type == \\\"array\\\"\" \"$dc\" >/dev/null 2>&1 || em true false unmeasured \"$n\" \"$cp\" \"release-ceremony.json changelog_embeds must be an array of {source, embed} objects\"; k=$(jq -r \".changelog_embeds | length\" \"$dc\" 2>/dev/null); case \"$k\" in \"\"|*[!0-9]*) em true false unmeasured \"$n\" \"$cp\" \"could not read the length of changelog_embeds from release-ceremony.json\" ;; esac; sf=\"$t/.release/changelog-embed-status.txt\"; if [ \"$k\" -eq 0 ]; then { printf \"CHANGELOG EMBED GATE: NOT APPLICABLE\\n\"; printf \"This repo DECLARES no changelog embeds (changelog_embeds: [] in release-ceremony.json).\\n\"; printf \"That is declared absence, recorded here so the ceremony record shows a decision\\n\"; printf \"somebody committed rather than a check that quietly found nothing to do.\\n\"; printf \"tree=%s version=%s\\n\" \"$t\" \"$v\"; } > \"$sf\" 2>/dev/null; em true true \"declared-none: repo declares no changelog embeds — gate NOT APPLICABLE, see .release/changelog-embed-status.txt\" \"$n\" \"$cp\" \"\"; fi; i=0; c=0; while [ \"$i\" -lt \"$k\" ]; do s=$(jq -r \".changelog_embeds[$i].source // empty\" \"$dc\" 2>/dev/null); b=$(jq -r \".changelog_embeds[$i].embed // empty\" \"$dc\" 2>/dev/null); if [ -z \"$s\" ] || [ -z \"$b\" ]; then em true false malformed \"$n\" \"$cp\" \"release-ceremony.json changelog_embeds entry $i is missing source or embed\"; fi; case \"$s$b\" in *..*) em true false malformed \"$n\" \"$cp\" \"release-ceremony.json changelog_embeds entry $i escapes the tree with .. — paths are tree-relative\" ;; esac; [ -f \"$t/$s\" ] || em true false missing-source \"$n\" \"$cp\" \"declared changelog source does not exist: $s — fix release-ceremony.json or restore the file, never drop the pair\"; [ -f \"$t/$b\" ] || em true false missing-embed \"$n\" \"$cp\" \"declared changelog embed does not exist: $b — the repo declares this embed, so its absence is drift and not a not-applicable case\"; cmp -s \"$t/$s\" \"$t/$b\" 2>/dev/null || em true false drifted \"$n\" \"$cp\" \"the embedded changelog has drifted from its authored source: $b differs from $s — sync the embed and re-land\"; c=$((c+1)); i=$((i+1)); done; { printf \"CHANGELOG EMBED GATE: VERIFIED\\n\"; printf \"%s declared pair(s), each byte-identical to its source.\\n\" \"$c\"; jq -r \".changelog_embeds[] | \\\"  \\\" + .source + \\\" == \\\" + .embed\" \"$dc\" 2>/dev/null; printf \"tree=%s version=%s\\n\" \"$t\" \"$v\"; } > \"$sf\" 2>/dev/null; em true true \"verified: $c declared pair(s) byte-identical to source\" \"$n\" \"$cp\" \"\";' -- $tree $version $prev_tag"
  /// Real public-surface diff. The tool being absent is a RED, not a pass.
  action run_semver_check(tree: String, version: String) -> SemverProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/Users/tom/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then if [ -d /home/aion ]; then HOME=/home/aion; else HOME=/Users/tom; fi; export HOME; fi; ulimit -n 65536 2>/dev/null || true; t=\"$1\"; v=\"$2\"; mkdir -p \"$t/.release\" 2>/dev/null; l=\"$t/.release/semver-check.log\"; if ! command -v cargo-semver-checks >/dev/null 2>&1; then printf \"{\\\"green\\\":false,\\\"attested\\\":false,\\\"citation\\\":\\\"\\\",\\\"rc\\\":90,\\\"log_path\\\":\\\"\\\",\\\"refusal\\\":\\\"cargo-semver-checks is not installed on this worker host — install it or dispatch with semver_mode attest and a citation\\\"}\"; exit 0; fi; ( cd \"$t\" && cargo semver-checks --workspace ) > \"$l\" 2>&1; rc=$?; g=false; [ \"$rc\" = \"0\" ] && g=true; r=\"\"; [ \"$g\" = \"false\" ] && r=\"public-surface break detected against the released baseline — read the log\"; printf \"{\\\"green\\\":%s,\\\"attested\\\":false,\\\"citation\\\":\\\"\\\",\\\"rc\\\":%d,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"%s\\\"}\" \"$g\" \"$rc\" \"$l\" \"$r\"' -- $tree $version"
  /// The delta-publish attestation: the operator names the battery-proven
  /// tree the delta rides on; an empty citation refuses.
  action record_attestation(citation: String) -> SemverProbe
    run json "sh -c 'set -u; c=\"$1\"; if [ -z \"$c\" ]; then printf \"{\\\"green\\\":false,\\\"attested\\\":false,\\\"citation\\\":\\\"\\\",\\\"rc\\\":91,\\\"log_path\\\":\\\"\\\",\\\"refusal\\\":\\\"an attestation requires a citation naming the battery-proven tree — named, recorded, never silent\\\"}\"; exit 0; fi; printf \"{\\\"green\\\":true,\\\"attested\\\":true,\\\"citation\\\":\\\"%s\\\",\\\"rc\\\":0,\\\"log_path\\\":\\\"\\\",\\\"refusal\\\":\\\"\\\"}\" \"$c\"' -- $citation"
  /// One crate, idempotent: skip when the index already holds the version,
  /// else publish with verify on; in either case confirm at the index and
  /// record the checksum as the step result. The confirm re-reads the index
  /// IN THE BODY (three reads over 40s) for the propagation-delay face —
  /// the body is exit-zero-always, so the ACTION retry can never fire for
  /// a typed refusal; any recheck must live inside the command itself.
  action publish_and_confirm(tree: String, crate_name: String, version: String) -> CrateProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/Users/tom/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then if [ -d /home/aion ]; then HOME=/home/aion; else HOME=/Users/tom; fi; export HOME; fi; ulimit -n 65536 2>/dev/null || true; t=\"$1\"; c=\"$2\"; v=\"$3\"; mkdir -p \"$t/.release\" 2>/dev/null; l=\"$t/.release/publish-$c.log\"; api=\"https://crates.io/api/v1/crates/$c/$v\"; body=$(curl -s -A aion-release-ceremony \"$api\"); sk=false; if printf \"%s\" \"$body\" | grep -q \"\\\"num\\\":\\\"$v\\\"\"; then sk=true; printf \"already at index\\n\" > \"$l\"; else ( cd \"$t\" && cargo publish -p \"$c\" ) > \"$l\" 2>&1; rc=$?; if [ \"$rc\" != \"0\" ]; then printf \"{\\\"crate_name\\\":\\\"%s\\\",\\\"skipped\\\":false,\\\"live\\\":false,\\\"checksum\\\":\\\"\\\",\\\"rc\\\":%d,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"cargo publish red — read the log\\\"}\" \"$c\" \"$rc\" \"$l\"; exit 0; fi; body=$(curl -s -A aion-release-ceremony \"$api\"); fi; n=0; while :; do ck=$(printf \"%s\" \"$body\" | sed -n \"s/.*.checksum...\\\\([0-9a-f]\\\\{64\\\\}\\\\).*/\\\\1/p\"); yk=false; printf \"%s\" \"$body\" | grep -q \"\\\"yanked\\\":true\" && yk=true; if [ -n \"$ck\" ] && [ \"$yk\" = \"false\" ]; then break; fi; if [ \"$n\" -ge 2 ]; then break; fi; n=$((n+1)); sleep 20; body=$(curl -s -A aion-release-ceremony \"$api\"); done; if [ -n \"$ck\" ] && [ \"$yk\" = \"false\" ]; then printf \"{\\\"crate_name\\\":\\\"%s\\\",\\\"skipped\\\":%s,\\\"live\\\":true,\\\"checksum\\\":\\\"%s\\\",\\\"rc\\\":0,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"\\\"}\" \"$c\" \"$sk\" \"$ck\" \"$l\"; else printf \"{\\\"crate_name\\\":\\\"%s\\\",\\\"skipped\\\":%s,\\\"live\\\":false,\\\"checksum\\\":\\\"\\\",\\\"rc\\\":92,\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"published but the index did not confirm a live %s at %s across three reads over 40s — propagation stall or yank; re-run the ceremony with the same input and the skips resume the chain\\\"}\" \"$c\" \"$sk\" \"$l\" \"$c\" \"$v\"; exit 0; fi' -- $tree $crate_name $version"
  /// The tag. Its DECLARED input is the full confirmation set — the set
  /// rides the action's recorded history as the tag's witness even though
  /// the command does not consume it: an array parameter cannot render into
  /// an argv word at all (crates/aion-worker/src/shell/template.rs,
  /// render_value refuses Array by name), so no shell-side re-check of the
  /// set is possible, and none is needed — the workflow's route gate
  /// (tag_step is reachable only through all(.live)) is the sole and
  /// sufficient guard. The same renderer law binds any future non-scalar
  /// parameter: scalars render verbatim as single argv words; arrays,
  /// objects, and null refuse at substitution. Idempotent: an existing
  /// v<version> tag on HEAD is green.
  action push_tag(tree: String, version: String, message: String, confirms: [CrateProbe]) -> TagProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/Users/tom/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then if [ -d /home/aion ]; then HOME=/home/aion; else HOME=/Users/tom; fi; export HOME; fi; t=\"$1\"; v=\"$2\"; m=\"$3\"; tag=\"v$v\"; if git -C \"$t\" rev-parse -q --verify \"refs/tags/$tag\" >/dev/null 2>&1; then :; else if ! git -C \"$t\" tag -a \"$tag\" -m \"$m\" >/dev/null 2>&1; then printf \"{\\\"green\\\":false,\\\"tag_ref\\\":\\\"\\\",\\\"refusal\\\":\\\"git tag creation failed\\\"}\"; exit 0; fi; fi; if ! git -C \"$t\" push origin \"$tag\" >/dev/null 2>&1; then printf \"{\\\"green\\\":false,\\\"tag_ref\\\":\\\"%s\\\",\\\"refusal\\\":\\\"tag exists locally but the push failed — re-run resumes it\\\"}\" \"$tag\"; exit 0; fi; printf \"{\\\"green\\\":true,\\\"tag_ref\\\":\\\"%s\\\",\\\"refusal\\\":\\\"\\\"}\" \"$tag\"' -- $tree $version $message"
  /// The shipped artifact proves itself: a from-index install into a scratch
  /// root, and the installed binary reports its version. DELIBERATELY
  /// UNLOCKED — no --locked — so the install resolves the dependency graph
  /// exactly as a user's cold `cargo install` will; that fresh resolve is
  /// what caught the registry liminal-sdk/haematite rot the night this was
  /// authored. Adding --locked to quiet a flake blinds the ceremony's best
  /// truth-teller; a red here is a fact about what users get.
  action verify_install(tree: String, crate_name: String, version: String) -> InstallProbe
    run json "sh -c 'set -u; PATH=/home/aion/.cargo/bin:/Users/tom/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; export PATH; if [ -z \"${HOME:-}\" ]; then if [ -d /home/aion ]; then HOME=/home/aion; else HOME=/Users/tom; fi; export HOME; fi; ulimit -n 65536 2>/dev/null || true; t=\"$1\"; c=\"$2\"; v=\"$3\"; mkdir -p \"$t/.release\" 2>/dev/null; l=\"$t/.release/install-verify.log\"; d=\"$t/.release/install-root\"; rm -rf \"$d\" 2>/dev/null; cargo install \"$c\" --version \"$v\" --root \"$d\" > \"$l\" 2>&1; rc=$?; if [ \"$rc\" != \"0\" ]; then printf \"{\\\"green\\\":false,\\\"rc\\\":%d,\\\"reported_version\\\":\\\"\\\",\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"from-index install red — read the log\\\"}\" \"$rc\" \"$l\"; exit 0; fi; b=$(ls \"$d/bin\" 2>/dev/null | head -1); if [ -z \"$b\" ]; then printf \"{\\\"green\\\":false,\\\"rc\\\":93,\\\"reported_version\\\":\\\"\\\",\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"install succeeded but no binary landed in the root\\\"}\" \"$l\"; exit 0; fi; rv=$(\"$d/bin/$b\" --version 2>/dev/null | head -1 | tr -d \"\\\"\"); g=false; printf \"%s\" \"$rv\" | grep -q \"$v\" && g=true; r=\"\"; [ \"$g\" = \"false\" ] && r=\"installed binary does not report the released version\"; printf \"{\\\"green\\\":%s,\\\"rc\\\":0,\\\"reported_version\\\":\\\"%s\\\",\\\"log_path\\\":\\\"%s\\\",\\\"refusal\\\":\\\"%s\\\"}\" \"$g\" \"$rv\" \"$l\" \"$r\"' -- $tree $crate_name $version"

type TreeProbe { ok: Bool, refusal: String, head_commit: String, workspace_version: String }

type ChangelogProbe {
  dated: Bool,
  embed_synced: Bool,
  embed_status: String,
  commit_count: Int,
  commits_path: String,
  refusal: String,
}

type SemverProbe {
  green: Bool,
  attested: Bool,
  citation: String,
  rc: Int,
  log_path: String,
  refusal: String,
}

type CrateProbe {
  crate_name: String,
  skipped: Bool,
  live: Bool,
  checksum: String,
  rc: Int,
  log_path: String,
  refusal: String,
}

type TagProbe { green: Bool, tag_ref: String, refusal: String }

type InstallProbe {
  green: Bool,
  rc: Int,
  reported_version: String,
  log_path: String,
  refusal: String,
}
